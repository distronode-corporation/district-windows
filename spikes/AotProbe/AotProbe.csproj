<Project Sdk="Microsoft.NET.Sdk">
  <!--
    W2 spike 6: the generated bindings under Native AOT. Published with
    PublishAot, with the trim and AOT analyzers on (their warnings are errors),
    then run: the real core through DistrictAI.Core, and the async callback
    checks of spike 2 through the spike crate's bindings. Never shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DistrictAI.AotProbe</RootNamespace>
    <PublishAot>true</PublishAot>
    <!--
      Both in the lock file, and the one for this OS chosen here rather than
      with `-r`, which would pass it to the referenced projects too and break
      their lock files.
    -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(OS)' != 'Windows_NT'">linux-x64</RuntimeIdentifier>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DistrictAI.Core/DistrictAI.Core.csproj" />
    <ProjectReference Include="../../tests/DistrictAI.Spikes/DistrictAI.Spikes.csproj" />
  </ItemGroup>
</Project>
