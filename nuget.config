<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org and nothing else, and every package mapped to it, so a package name
  can never be satisfied from a source added on someone's machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
