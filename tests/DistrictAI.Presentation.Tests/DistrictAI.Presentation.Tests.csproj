<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The view models in DistrictAI.Presentation, fed the core's generated view
    records directly and sending to a recorder instead of the core. No native
    library is loaded: constructing a record or an event calls nothing in
    district-ffi.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DistrictAI.Presentation.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DistrictAI.Presentation/DistrictAI.Presentation.csproj" />
  </ItemGroup>
</Project>
