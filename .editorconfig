# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,md,json,xml,props,targets,csproj,appxmanifest}]
indent_size = 2

# Trailing whitespace is significant in Markdown (two spaces is a hard line break),
# so the global trim rule is turned off here rather than silently rewriting prose.
[*.md]
trim_trailing_whitespace = false
