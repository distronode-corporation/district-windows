<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DistrictAI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Every signed-in page has one frame, as Windows Settings draws its
                pages: content anchored to the left edge, inside PagePadding, the
                level-one heading at its top left, so the heading never moves
                between pages. A list (calls, contacts, conversations) takes the
                width it is given; a page of text, cards or a form is held to
                ReadingWidth, still on the left (HorizontalAlignment="Left"),
                never centred in the window.
            -->
            <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
            <x:Double x:Key="ReadingWidth">760</x:Double>

            <!-- A button label that wraps instead of being cut (DialogButtons). -->
            <DataTemplate x:Key="WrappingLabelTemplate">
                <TextBlock
                    Text="{Binding}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </DataTemplate>

            <!-- A line that says something about the page without competing with it. -->
            <Style
                x:Key="QuietTextStyle"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A section's heading inside a page. -->
            <Style
                x:Key="SectionHeaderStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <!-- A card: the finish-setup card, a metric, a call in a conversation. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
