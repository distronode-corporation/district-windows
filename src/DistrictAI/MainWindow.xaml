<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DistrictAI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    Title="District AI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="Notice"
            AutomationProperties.Name="Notice"
            IsOpen="False"
            Severity="Warning" />
        <views:SignInPage x:Name="SignIn" Grid.Row="1" />
        <!-- Signed in: the navigation view arrives with W3. -->
        <TextBlock
            x:Name="SignedIn"
            Grid.Row="1"
            AutomationProperties.Name="Signed in"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="You are signed in. The workspace screens arrive in a later build." />
    </Grid>
</Window>
