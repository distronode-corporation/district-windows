<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.RefreshStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <!-- Over content already shown: a refresh under way, or one that failed. -->
    <StackPanel Spacing="4">
        <ProgressBar
            AutomationProperties.Name="{x:Bind l10n:S.RefreshRefreshing}"
            IsIndeterminate="True"
            Visibility="{x:Bind State.Refreshing, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.RefreshFailed}"
            IsClosable="False"
            IsOpen="{x:Bind State.HasRefreshFailure, Mode=OneWay}"
            Message="{x:Bind State.RefreshFailureMessage, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="TryAgainButton"
                    AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                    Command="{x:Bind State.RetryCommand}"
                    Content="{x:Bind l10n:S.CommonTryAgain}"
                    Visibility="{x:Bind State.CanRetryRefresh, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>
    </StackPanel>
</UserControl>
