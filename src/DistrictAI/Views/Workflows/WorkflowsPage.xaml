<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Workflows.WorkflowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:wf="using:DistrictAI.ViewModels.Workflows">
    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource ReadingWidth}"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Stretch"
            Spacing="12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

            <!-- The outbound campaign: its state, and pausing or resuming it after the core's question. -->
            <Border AutomationProperties.Name="{x:Bind ViewModel.CampaignTitle, Mode=OneWay}" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.CampaignTitle, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Badge, Mode=OneWay}" />
                    </Grid>
                    <views:StatusPanel x:Name="CampaignStatus" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CampaignLoad.Ready, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.BatchLabel, Mode=OneWay}" />
                            <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Batch, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.GoalLabel, Mode=OneWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Goal, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <InfoBar
                            AutomationProperties.Name="Could not change the campaign"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasCampaignFailure, Mode=OneWay}"
                            Message="{x:Bind ViewModel.CampaignFailure, Mode=OneWay}"
                            Severity="Error" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.Name="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PauseCommand}"
                                Content="{x:Bind ViewModel.PauseLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowPause, Mode=OneWay}" />
                            <Button
                                AutomationProperties.Name="{x:Bind ViewModel.ResumeLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ResumeCommand}"
                                Content="{x:Bind ViewModel.ResumeLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.ShowResume, Mode=OneWay}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                AutomationProperties.Name="Changing the campaign"
                                IsActive="{x:Bind ViewModel.CampaignPending, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CampaignPending, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind ViewModel.CampaignNote, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                AutomationProperties.Name="Could not change a workflow"
                CloseButtonClick="OnToggleFailureClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasToggleFailure, Mode=OneWay}"
                Message="{x:Bind ViewModel.ToggleFailure, Mode=OneWay}"
                Severity="Error" />

            <Grid>
                <views:StatusPanel x:Name="Status" />
                <!--
                    One flat list: each workflow, followed by its runs and their end
                    while they are open (one at a time). One template, whose parts
                    show by the line's kind.
                -->
                <ItemsRepeater
                    AutomationProperties.Name="Workflows"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="wf:WorkflowEntry">
                            <Grid AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind IsWorkflow}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Detail}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind RunsButtonName}"
                                            Click="OnRunsClick"
                                            Content="{x:Bind RunsButtonLabel}" />
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind SwitchName}"
                                            IsEnabled="{x:Bind CanSwitch}"
                                            IsOn="{x:Bind Active}"
                                            Toggled="OnSwitchToggled" />
                                    </Grid>
                                </Border>
                                <Grid
                                    Padding="24,0,16,0"
                                    ColumnSpacing="12"
                                    Visibility="{x:Bind IsRun}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind When}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource QuietTextStyle}"
                                            Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}"
                                        Visibility="{x:Bind IsSuccess}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}"
                                        Visibility="{x:Bind IsWarning}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}"
                                        Visibility="{x:Bind IsDanger}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Status}"
                                        Visibility="{x:Bind IsNeutral}" />
                                </Grid>
                                <StackPanel
                                    Padding="24,0,16,0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind IsFooter}">
                                    <ProgressRing
                                        Width="20"
                                        Height="20"
                                        AutomationProperties.Name="Reading runs"
                                        IsActive="{x:Bind RunsLoading}"
                                        Visibility="{x:Bind RunsLoading}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind RunsNote}"
                                        Visibility="{x:Bind HasRunsNote}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="{x:Bind RunsFailure}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasRunsFailure}" />
                                    <Button
                                        AutomationProperties.Name="{x:Bind MoreLabel}"
                                        Click="OnMoreRunsClick"
                                        Content="{x:Bind MoreLabel}"
                                        IsEnabled="{x:Bind CanLoadMore}"
                                        Visibility="{x:Bind CanLoadMore}" />
                                    <Button
                                        AutomationProperties.Name="Try again"
                                        Click="OnRetryRunsClick"
                                        Content="Try again"
                                        IsEnabled="{x:Bind CanRetryRuns}"
                                        Visibility="{x:Bind CanRetryRuns}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
