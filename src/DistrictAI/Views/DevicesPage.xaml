<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind l10n:S.DevicesTitle}" />
            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind l10n:S.DevicesLastActiveNote}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="4">
            <views:RefreshStrip x:Name="Refresh" />
            <InfoBar
                AutomationProperties.Name="{x:Bind l10n:S.DevicesSignOutNotice}"
                CloseButtonClick="OnNoticeClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                Severity="Informational" />
            <ProgressBar
                AutomationProperties.Name="{x:Bind l10n:S.DevicesSigningOut}"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
        </StackPanel>
        <ListView
            Grid.Row="2"
            AutomationProperties.Name="{x:Bind l10n:S.DevicesTitle}"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceRowItem">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Detail}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind l10n:S.DevicesThisDevice}"
                            Visibility="{x:Bind IsThisDevice}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind SignOutName}"
                            Click="OnSignOutClick"
                            Content="{x:Bind l10n:S.CommonSignOut}"
                            IsEnabled="{x:Bind CanSignOut}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="2" />
        <Button
            Grid.Row="3"
            AutomationProperties.Name="{x:Bind l10n:S.DevicesSignOutEverywhere}"
            Command="{x:Bind ViewModel.SignOutEverywhereCommand}"
            Content="{x:Bind l10n:S.DevicesSignOutEverywhere}"
            IsEnabled="{x:Bind ViewModel.EverywhereEnabled, Mode=OneWay}" />
    </Grid>
</UserControl>
