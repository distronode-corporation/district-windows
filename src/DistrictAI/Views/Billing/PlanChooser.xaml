<?xml version="1.0" encoding="utf-8"?>
<!--
    Choosing a plan and managing billing inside the app: "Choose a plan" and
    "Manage billing", the chooser, the step that names Stripe, and the checkout
    window's progress and notice. The billing screen shows it, and so does the
    overview of an account with no workspace yet.
-->
<UserControl
    x:Class="DistrictAI.Views.Billing.PlanChooser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.AutomationId="ChoosePlanButton"
                AutomationProperties.Name="{x:Bind ViewModel.ChooseAction, Mode=OneWay}"
                Command="{x:Bind ViewModel.OpenChooserCommand}"
                Content="{x:Bind ViewModel.ChooseAction, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.ManageAction, Mode=OneWay}"
                Command="{x:Bind ViewModel.ManageInAppCommand}"
                Content="{x:Bind ViewModel.ManageAction, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.OffersManage, Mode=OneWay}" />
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.Name="{x:Bind ViewModel.OpeningLabel, Mode=OneWay}"
                IsActive="{x:Bind ViewModel.Opening, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Opening, Mode=OneWay}" />
        </StackPanel>
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.BillingCheckoutInBrowser}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasInBrowserNote, Mode=OneWay}"
            Message="{x:Bind ViewModel.InBrowserNote, Mode=OneWay}"
            Severity="Informational" />
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.BillingProblem}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Warning" />

        <!--  The chooser.  -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ChooserVisible, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.ChooseAction, Mode=OneWay}" />
                <RadioButtons
                    AutomationProperties.Name="{x:Bind l10n:S.BillingPlan}"
                    Header="{x:Bind l10n:S.BillingPlan}"
                    ItemsSource="{x:Bind ViewModel.PlanNames, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedPlan, Mode=TwoWay}" />
                <ComboBox
                    AutomationProperties.Name="{x:Bind l10n:S.BillingBilled}"
                    Header="{x:Bind l10n:S.BillingBilled}"
                    ItemsSource="{x:Bind ViewModel.TermNames, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedTerm, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.AutomationId="PromoCodeBox"
                    AutomationProperties.Name="{x:Bind l10n:S.BillingPromotionCode}"
                    Header="{x:Bind ViewModel.PromoLabel, Mode=OneWay}"
                    MaxLength="64"
                    Text="{x:Bind ViewModel.PromoText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.PromoError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasPromoError, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.PricesNote, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind l10n:S.BillingContinue}"
                        Command="{x:Bind ViewModel.ContinueCommand}"
                        Content="{x:Bind l10n:S.BillingContinue}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.Name="{x:Bind l10n:S.BillingClosePlans}"
                        Command="{x:Bind ViewModel.CloseChooserCommand}"
                        Content="{x:Bind l10n:S.CommonClose}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  The step that names Stripe before checkout opens.  -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Confirming, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.ConfirmTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.ConfirmChoice, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ConfirmBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.ConfirmAction, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmCommand}"
                        Content="{x:Bind ViewModel.ConfirmAction, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.CancelAction, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="{x:Bind ViewModel.CancelAction, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
