<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Calls.DialerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:calls="using:DistrictAI.ViewModels.Calls"
    xmlns:l10n="using:DistrictAI.L10n">
    <ScrollViewer>
        <views:PageColumn>
            <StackPanel
                MaxWidth="440"
                Padding="{StaticResource PagePadding}"
                Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind l10n:S.DialerTitle}" />
                <!-- The country button and its searchable list, in front of the box. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="CountryButton"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="DialCountryButton"
                        AutomationProperties.Name="{x:Bind ViewModel.CountryLabel, Mode=OneWay}"
                        Content="{x:Bind ViewModel.CountryButton, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CountryLabel, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="CountryFlyout" Opening="OnCountriesOpening" Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="320" Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.CountriesTitle, Mode=OneWay}" />
                                    <TextBox
                                        x:Name="CountrySearch"
                                        AutomationProperties.AutomationId="DialCountrySearch"
                                        AutomationProperties.Name="{x:Bind ViewModel.CountrySearchPlaceholder, Mode=OneWay}"
                                        IsSpellCheckEnabled="False"
                                        KeyDown="OnCountrySearchKeyDown"
                                        PlaceholderText="{x:Bind ViewModel.CountrySearchPlaceholder, Mode=OneWay}"
                                        TextChanged="OnCountrySearchChanged" />
                                    <TextBlock
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind ViewModel.NoCountryMatch, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.HasNoCountryMatch, Mode=OneWay}" />
                                    <ListView
                                        MaxHeight="400"
                                        AutomationProperties.AutomationId="DialCountryList"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnCountryClick"
                                        ItemsSource="{x:Bind ViewModel.Countries}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="calls:CountryRowItem">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="20" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        Style="{StaticResource QuietTextStyle}"
                                                        Text="{x:Bind Iso}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Style="{StaticResource QuietTextStyle}"
                                                        Text="{x:Bind CallingCode}" />
                                                    <FontIcon
                                                        Grid.Column="3"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="12"
                                                        Glyph="&#xE73E;"
                                                        Visibility="{x:Bind Selected}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox
                        x:Name="NumberBox"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="DialNumberBox"
                        AutomationProperties.Name="{x:Bind l10n:S.DialerNumber}"
                        Header="{x:Bind l10n:S.DialerNumber}"
                        InputScope="TelephoneNumber"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        KeyDown="OnNumberKeyDown"
                        LostFocus="OnNumberLostFocus"
                        PlaceholderText="{x:Bind ViewModel.Placeholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <!-- Where the call rings and the whole number sent, once it is whole. -->
                <TextBlock
                    AutomationProperties.AutomationId="DialDestination"
                    AutomationProperties.LiveSetting="Polite"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Destination, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ShowHint, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="DialProblem"
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.Problem, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}" />
                <StackPanel x:Name="CallRow" Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="CallButton"
                        AutomationProperties.AutomationId="DialCallButton"
                        AutomationProperties.Name="{x:Bind l10n:S.CommonCall}"
                        Command="{x:Bind ViewModel.DialCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Phone" />
                            <TextBlock Text="{x:Bind l10n:S.CommonCall}" />
                        </StackPanel>
                    </Button>
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="{x:Bind l10n:S.DialerPlacing}"
                        IsActive="{x:Bind ViewModel.Dialing, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Dialing, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.MicrophoneNote, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Note, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNote, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.Name="{x:Bind l10n:S.CommonCallProblem}"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Failure, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </views:PageColumn>
    </ScrollViewer>
</UserControl>
