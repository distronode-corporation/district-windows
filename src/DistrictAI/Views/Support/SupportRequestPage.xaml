<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Support.SupportRequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels.Support">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.ReferenceLine, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.CloseOffered, Mode=OneWay}">
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="Marking as resolved"
                    IsActive="{x:Bind ViewModel.Closing, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Closing, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="{x:Bind ViewModel.CloseAction, Mode=OneWay}"
                    Command="{x:Bind ViewModel.AskCloseCommand}"
                    Content="{x:Bind ViewModel.CloseAction, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- The question before closing: it cannot be undone from here. -->
        <Border
            Grid.Row="1"
            MaxWidth="{StaticResource ReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.ConfirmingClose, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.CloseQuestion, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.CloseAction, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmCloseCommand}"
                        Content="{x:Bind ViewModel.CloseAction, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.Name="Keep it open"
                        Command="{x:Bind ViewModel.CancelCloseCommand}"
                        Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <views:RefreshStrip x:Name="Refresh" Grid.Row="2" />

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar
                AutomationProperties.Name="Problem with this request"
                CloseButtonCommand="{x:Bind ViewModel.DismissNoticesCommand}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                Message="{x:Bind ViewModel.Failure, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                AutomationProperties.Name="Request resolved"
                CloseButtonCommand="{x:Bind ViewModel.DismissNoticesCommand}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasClosed, Mode=OneWay}"
                Message="{x:Bind ViewModel.Closed, Mode=OneWay}"
                Severity="Success" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            AutomationProperties.Name="Conversation"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SupportMessageItem">
                    <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                        <!-- Written by the workspace. -->
                        <Border
                            MaxWidth="560"
                            Padding="12,8"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Visibility="{x:Bind FromWorkspace}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Body}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Meta}" />
                            </StackPanel>
                        </Border>
                        <!-- Written by Distronode. -->
                        <Border
                            MaxWidth="560"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}"
                            Visibility="{x:Bind FromDistronode}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Body}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="4" />

        <!-- The reply. What was written stays when sending it fails. -->
        <Grid
            Grid.Row="5"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxHeight="160"
                AcceptsReturn="True"
                AutomationProperties.Name="Reply"
                Header="Reply"
                IsEnabled="{x:Bind ViewModel.CanWriteReply, Mode=OneWay}"
                Text="{x:Bind ViewModel.Reply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="Sending the reply"
                    IsActive="{x:Bind ViewModel.Sending, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Sending, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="Send the reply"
                    Command="{x:Bind ViewModel.SendReplyCommand}"
                    Content="Send"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
