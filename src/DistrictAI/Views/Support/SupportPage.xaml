<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Support.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels.Support">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind l10n:S.SupportTitle}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind l10n:S.SupportNewA11y}"
                Command="{x:Bind ViewModel.StartRequestCommand}"
                Content="{x:Bind l10n:S.SupportNew}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
        </Grid>

        <!-- The confirmation of a request raised, until put away. -->
        <InfoBar
            Grid.Row="1"
            AutomationProperties.Name="{x:Bind l10n:S.SupportSent}"
            CloseButtonCommand="{x:Bind ViewModel.DismissSubmittedCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasSubmitted, Mode=OneWay}"
            Message="{x:Bind ViewModel.Submitted, Mode=OneWay}"
            Severity="Success" />

        <!-- The form raising a request, while it is open. -->
        <Border
            Grid.Row="2"
            MaxWidth="{StaticResource ReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.Composing, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.ComposeTitle, Mode=OneWay}" />
                <ComboBox
                    MinWidth="240"
                    AutomationProperties.Name="{x:Bind l10n:S.SupportTopic}"
                    Header="{x:Bind l10n:S.SupportTopic}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.KindLabels}"
                    SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=TwoWay}" />
                <TextBox
                    AutomationProperties.Name="{x:Bind l10n:S.CommonSubject}"
                    Header="{x:Bind l10n:S.CommonSubject}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="{x:Bind ViewModel.SubjectMax, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    MinHeight="120"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind l10n:S.SupportWhatIsHappening}"
                    Header="{x:Bind l10n:S.SupportWhatIsHappening}"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="{x:Bind ViewModel.MessageMax, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Needs, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNeeds, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.Name="{x:Bind l10n:S.SupportNotSent}"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasComposeFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ComposeFailure, Mode=OneWay}"
                    Severity="Error" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind l10n:S.SupportSend}"
                        Command="{x:Bind ViewModel.SubmitRequestCommand}"
                        Content="{x:Bind l10n:S.CommonSend}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.Name="{x:Bind l10n:S.SupportDiscardA11y}"
                        Command="{x:Bind ViewModel.CancelRequestCommand}"
                        Content="{x:Bind l10n:S.SupportDiscard}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="{x:Bind l10n:S.SupportSending}"
                        IsActive="{x:Bind ViewModel.Submitting, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Submitting, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <views:RefreshStrip x:Name="Refresh" Grid.Row="3" />

        <ScrollViewer Grid.Row="4" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind l10n:S.SupportOpen}"
                    Visibility="{x:Bind ViewModel.HasOpen, Mode=OneWay}" />
                <ListView
                    AutomationProperties.Name="{x:Bind l10n:S.SupportOpenList}"
                    IsItemClickEnabled="True"
                    ItemClick="OnRequestClick"
                    ItemsSource="{x:Bind ViewModel.Open}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasOpen, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupportRowItem">
                            <StackPanel
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Subject}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource QuietTextStyle}"
                                    Text="{x:Bind Line}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind l10n:S.SupportResolved}"
                    Visibility="{x:Bind ViewModel.HasResolved, Mode=OneWay}" />
                <ListView
                    AutomationProperties.Name="{x:Bind l10n:S.SupportResolvedList}"
                    IsItemClickEnabled="True"
                    ItemClick="OnRequestClick"
                    ItemsSource="{x:Bind ViewModel.Resolved}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasResolved, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupportRowItem">
                            <StackPanel
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Subject}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource QuietTextStyle}"
                                    Text="{x:Bind Line}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.CappedNote, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasCappedNote, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" Grid.Row="4" />
    </Grid>
</UserControl>
