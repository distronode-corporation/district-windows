<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Settings.VoiceStudio.VoiceStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels"
    xmlns:vs="using:DistrictAI.ViewModels.Settings.VoiceStudio">
    <UserControl.Resources>
        <!-- One tuning control: its parts show by its kind. -->
        <DataTemplate x:Key="TuningTemplate" x:DataType="vs:StudioTuningItem">
            <StackPanel Padding="0,4" Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Heading, Mode=OneWay}"
                    Visibility="{x:Bind HasHeading, Mode=OneWay}" />
                <StackPanel Spacing="4" Visibility="{x:Bind IsSlider, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                            Header="{x:Bind Label, Mode=OneWay}"
                            IsEnabled="{x:Bind SliderEnabled, Mode=OneWay}"
                            Maximum="{x:Bind Maximum, Mode=OneWay}"
                            Minimum="{x:Bind Minimum, Mode=OneWay}"
                            StepFrequency="{x:Bind Step, Mode=OneWay}"
                            Value="{x:Bind Value, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Text="{x:Bind ValueText, Mode=OneWay}" />
                    </Grid>
                    <CheckBox
                        AutomationProperties.Name="{x:Bind DefaultLabel, Mode=OneWay}"
                        Click="OnDefaultClick"
                        Content="{x:Bind DefaultLabel, Mode=OneWay}"
                        IsChecked="{x:Bind UseDefault, Mode=OneWay}"
                        Visibility="{x:Bind HasDefault, Mode=OneWay}" />
                </StackPanel>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                    Header="{x:Bind Label, Mode=OneWay}"
                    ItemsSource="{x:Bind Options}"
                    SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                    Visibility="{x:Bind IsSelect, Mode=OneWay}" />
                <ToggleSwitch
                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                    Header="{x:Bind Label, Mode=OneWay}"
                    IsOn="{x:Bind On, Mode=TwoWay}"
                    Visibility="{x:Bind IsSwitch, Mode=OneWay}" />
                <TextBox
                    MinHeight="80"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                    Header="{x:Bind Label, Mode=OneWay}"
                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind IsLines, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind HasDescription, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource ReadingWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <views:StatusPanel x:Name="StudioStatus" />

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStudio, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />

                <!-- The tier, and its recipes. -->
                <StackPanel Spacing="4">
                    <RadioButtons
                        AutomationProperties.Name="{x:Bind ViewModel.TierLabel, Mode=OneWay}"
                        Header="{x:Bind ViewModel.TierLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Tiers}"
                        MaxColumns="2"
                        SelectedIndex="{x:Bind ViewModel.TierIndex, Mode=TwoWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.TierDescription, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.RecipesLabel, Mode=OneWay}" />
                <ListView
                    AutomationProperties.Name="{x:Bind ViewModel.RecipesLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecipeClick"
                    ItemsSource="{x:Bind ViewModel.Recipes}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vs:StudioRecipeItem">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind Selected}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind Facts}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Badge}"
                                    Visibility="{x:Bind HasBadge}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasBasedOn, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.BasedOn, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind ViewModel.ResetLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ResetCommand}"
                        Content="{x:Bind ViewModel.ResetLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}" />
                </Grid>

                <!-- The signal chain: a leg opens its editor. -->
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.ChainLabel, Mode=OneWay}" />
                <ListView
                    AutomationProperties.Name="{x:Bind ViewModel.ChainLabel, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="OnBlockClick"
                    ItemsSource="{x:Bind ViewModel.Blocks}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vs:StudioBlockItem">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="&#xE70F;"
                                    Visibility="{x:Bind Open}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The editor of the open leg. -->
                <!-- A panel has no IsEnabled of its own: the content control holds it for every control inside. -->
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                    IsTabStop="False">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level3"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pickers}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vs:StudioPickerItem">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                            Header="{x:Bind Label, Mode=OneWay}"
                                            ItemsSource="{x:Bind Options}"
                                            SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <ItemsRepeater ItemTemplate="{StaticResource TuningTemplate}" ItemsSource="{x:Bind ViewModel.Controls}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind ViewModel.AdvancedLabel, Mode=OneWay}"
                                Header="{x:Bind ViewModel.AdvancedLabel, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasAdvanced, Mode=OneWay}">
                                <ItemsRepeater ItemTemplate="{StaticResource TuningTemplate}" ItemsSource="{x:Bind ViewModel.AdvancedControls}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </Expander>
                        </StackPanel>
                    </Border>
                </ContentControl>

                <!-- The time to first word. -->
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.MeterHeading, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.MeterDescription, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.MeterHeadline, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.MeterNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasMeterNote, Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Stages}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FactItem">
                            <Grid AutomationProperties.Name="{x:Bind AccessibleName}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource QuietTextStyle}"
                                    Text="{x:Bind Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.MeterSource, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!-- Where the call is processed. -->
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="{x:Bind ViewModel.ResidencyHeading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ResidencyText, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.LegsOut, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasLegsOut, Mode=OneWay}" />

                <!-- How the last save went, until an edit or Dismiss. -->
                <InfoBar
                    AutomationProperties.Name="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    CloseButtonClick="OnNoticeClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.NoticeSaved, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Success" />
                <InfoBar
                    AutomationProperties.Name="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    CloseButtonClick="OnNoticeClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.NoticeWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Warning" />
                <InfoBar
                    AutomationProperties.Name="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    CloseButtonClick="OnNoticeClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.NoticeError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Error" />

                <!-- The save. -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Saving"
                        IsActive="{x:Bind ViewModel.Saving, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Saving, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Pending, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
