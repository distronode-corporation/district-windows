<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Settings.Persona.PersonaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:persona="using:DistrictAI.Views.Settings.Persona">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

                <ProgressRing
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Loading"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- A failed read, or a save that landed and was not read back: no form. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusBody, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.StatusAction, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Content="{x:Bind ViewModel.StatusAction, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStatusAction, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Bind ViewModel.TextsHeading, Mode=OneWay}" />
                    <TextBox
                        AutomationProperties.Name="Name"
                        Header="Name"
                        IsEnabled="{x:Bind ViewModel.TextEditable, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.Name="Greeting"
                        Header="Greeting"
                        IsEnabled="{x:Bind ViewModel.TextEditable, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Greeting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <TextBox
                        MinHeight="120"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Personality"
                        Header="Personality"
                        IsEnabled="{x:Bind ViewModel.TextEditable, Mode=OneWay}"
                        IsSpellCheckEnabled="True"
                        Text="{x:Bind ViewModel.Personality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind ViewModel.ClearHint, Mode=OneWay}" />

                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Bind ViewModel.EngineHeading, Mode=OneWay}" />
                    <!-- Why the language half is not shown: being read, or read only. -->
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.EngineNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasEngineNote, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Read the languages again"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Content="Try again"
                        Visibility="{x:Bind ViewModel.CanRetryOptions, Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasEngine, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Voice engine" />
                                <TextBlock Text="{x:Bind ViewModel.EngineLabel, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="{x:Bind ViewModel.StudioHint, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.StudioLabel, Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenStudioCommand}"
                                Content="{x:Bind ViewModel.StudioLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StudioHint, Mode=OneWay}" />
                        </Grid>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Language"
                            Header="Language"
                            IsEnabled="{x:Bind ViewModel.EngineEditable, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.Languages}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Answer length"
                            Header="Answer length"
                            IsEnabled="{x:Bind ViewModel.EngineEditable, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.ResponseLengths}"
                            SelectedItem="{x:Bind ViewModel.SelectedResponseLength, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.RefitLine, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasRefitLine, Mode=OneWay}" />

                    <!-- How the last save ended, until dismissed or the form changes. -->
                    <InfoBar
                        x:Name="Notice"
                        CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                        Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                        Severity="{x:Bind persona:PersonaPage.SeverityFor(ViewModel.NoticeSaved), Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="{x:Bind ViewModel.PreviewLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenPreviewCommand}"
                            Content="{x:Bind ViewModel.PreviewLabel, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanPreview, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            AutomationProperties.Name="Saving"
                            IsActive="{x:Bind ViewModel.Saving, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Saving, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The audition: a real, billed call, said before Start. -->
        <ContentDialog
            x:Name="Audition"
            CloseButtonText="Close"
            DefaultButton="Close"
            Style="{StaticResource DefaultContentDialogStyle}"
            Title="{x:Bind ViewModel.AuditionTitle, Mode=OneWay}">
            <StackPanel MaxWidth="440" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.BilledNote, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasAuditionState, Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        AutomationProperties.Name="{x:Bind ViewModel.AuditionState, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.AuditionWaiting, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.AuditionWaiting, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.AuditionState, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    AutomationProperties.LiveSetting="Assertive"
                    Text="{x:Bind ViewModel.AuditionFailure, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasAuditionFailure, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Cooling, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasCooling, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StartPreviewCommand}"
                        Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.StopLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.StopPreviewCommand}"
                        Content="{x:Bind ViewModel.StopLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowStop, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
