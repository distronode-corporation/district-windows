<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Settings.Messaging.MessagingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:vm="using:DistrictAI.ViewModels.Settings.Messaging">
    <ScrollViewer AutomationProperties.AutomationId="MessagingScroll">
        <views:PageColumn>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind l10n:S.MessagingAddAccountA11y}"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Content="{x:Bind l10n:S.MessagingAddAccount}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.OffersAdd, Mode=OneWay}" />
                </Grid>

                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.ViewerNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasViewerNote, Mode=OneWay}" />

                <InfoBar
                    AutomationProperties.AutomationId="MessagingSavedNotice"
                    AutomationProperties.Name="{x:Bind l10n:S.MessagingSaved}"
                    CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.NoticeSaved, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                    Severity="Success" />
                <InfoBar
                    AutomationProperties.AutomationId="MessagingFailedNotice"
                    AutomationProperties.Name="{x:Bind l10n:S.MessagingNotSaved}"
                    CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.NoticeFailed, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                    Severity="Error" />

                <ProgressRing
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="LoadingRing"
                    AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!-- The read failed: why, and Try again when it may help. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusBody, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.AutomationId="TryAgainButton"
                        AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Content="{x:Bind l10n:S.CommonTryAgain}"
                        Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
                </StackPanel>

                <!-- The question before removing an account. -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Confirming, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.AutomationId="MessagingConfirmTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ConfirmTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ConfirmBody, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.Name="{x:Bind ViewModel.ConfirmAction, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ConfirmRemoveCommand}"
                                Content="{x:Bind ViewModel.ConfirmAction, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                AutomationProperties.AutomationId="MessagingKeepAccount"
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingKeepAccount}"
                                Command="{x:Bind ViewModel.CancelRemoveCommand}"
                                Content="{x:Bind l10n:S.CommonCancel}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The form adding or editing an account. Keys go in password boxes and never come back. -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.FormOpen, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.AutomationId="MessagingFormTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" />
                        <ComboBox
                            MinWidth="200"
                            AutomationProperties.Name="{x:Bind l10n:S.MessagingCarrier}"
                            Header="{x:Bind l10n:S.MessagingCarrier}"
                            IsEnabled="{x:Bind ViewModel.FormEditable, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.CarrierLabels}"
                            SelectedIndex="{x:Bind ViewModel.CarrierIndex, Mode=TwoWay}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.CarrierSwitch, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasCarrierSwitch, Mode=OneWay}" />
                        <ComboBox
                            MinWidth="200"
                            AutomationProperties.Name="{x:Bind l10n:S.MessagingWhoseAccount}"
                            Header="{x:Bind l10n:S.MessagingWhoseAccount}"
                            IsEnabled="{x:Bind ViewModel.FormEditable, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.SourceLabels}"
                            SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}" />
                        <TextBox
                            AutomationProperties.Name="{x:Bind l10n:S.CommonName}"
                            Header="{x:Bind l10n:S.CommonName}"
                            IsEnabled="{x:Bind ViewModel.FormEditable, Mode=OneWay}"
                            Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level3"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind l10n:S.MessagingKeys}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Keys}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyItem">
                                    <Grid>
                                        <PasswordBox
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Header="{x:Bind Label}"
                                            Password="{x:Bind SecretValue, Mode=TwoWay}"
                                            Visibility="{x:Bind Secret}" />
                                        <TextBox
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Header="{x:Bind Label}"
                                            IsSpellCheckEnabled="False"
                                            Text="{x:Bind PlainValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{x:Bind Plain}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.KeysNote, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingCheckKeys}"
                                Command="{x:Bind ViewModel.CheckKeysCommand}"
                                Content="{x:Bind l10n:S.MessagingCheckKeys}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind ViewModel.CheckHint, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasCheckHint, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.CheckResult, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasCheckResult, Mode=OneWay}" />
                        <TextBox
                            MinHeight="80"
                            AcceptsReturn="True"
                            AutomationProperties.Name="{x:Bind l10n:S.MessagingNumbers}"
                            Header="{x:Bind l10n:S.MessagingNumbers}"
                            IsEnabled="{x:Bind ViewModel.FormEditable, Mode=OneWay}"
                            Text="{x:Bind ViewModel.PhoneNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.NumbersHelp, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            AutomationProperties.Name="{x:Bind l10n:S.MessagingMakeDefaultSender}"
                            Content="{x:Bind l10n:S.MessagingMakeDefaultSender}"
                            IsChecked="{x:Bind ViewModel.MakeDefault, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.FormEditable, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingSaveAccount}"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                Content="{x:Bind l10n:S.CommonSave}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                AutomationProperties.AutomationId="MessagingCloseForm"
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingCloseForm}"
                                Command="{x:Bind ViewModel.CloseFormCommand}"
                                Content="{x:Bind l10n:S.CommonCancel}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                AutomationProperties.Name="{x:Bind l10n:S.CommonSaving}"
                                IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Bind l10n:S.MessagingAccounts}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasEmpty, Mode=OneWay}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.EmptyBody, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Accounts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessagingAccountItem">
                                <Border AutomationProperties.Name="{x:Bind AccessibleName}" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Label}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind l10n:S.MessagingDefault}"
                                                Visibility="{x:Bind IsDefault}" />
                                        </StackPanel>
                                        <TextBlock
                                            Style="{StaticResource QuietTextStyle}"
                                            Text="{x:Bind Line}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                AutomationProperties.AutomationId="MessagingMakeDefault"
                                                AutomationProperties.Name="{x:Bind l10n:S.MessagingMakeDefaultA11y}"
                                                Click="OnMakeDefault"
                                                Content="{x:Bind l10n:S.MessagingMakeDefault}"
                                                IsEnabled="{x:Bind Enabled}"
                                                Tag="{x:Bind Id}"
                                                Visibility="{x:Bind OffersMakeDefault}" />
                                            <Button
                                                AutomationProperties.AutomationId="MessagingEditAccount"
                                                AutomationProperties.Name="{x:Bind l10n:S.MessagingEditAccount}"
                                                Click="OnEditAccount"
                                                Content="{x:Bind l10n:S.CommonEdit}"
                                                IsEnabled="{x:Bind Enabled}"
                                                Tag="{x:Bind Id}"
                                                Visibility="{x:Bind OffersEdit}" />
                                            <Button
                                                AutomationProperties.AutomationId="MessagingRemoveAccount"
                                                AutomationProperties.Name="{x:Bind l10n:S.MessagingRemoveAccount}"
                                                Click="OnRemoveAccount"
                                                Content="{x:Bind l10n:S.CommonRemove}"
                                                IsEnabled="{x:Bind Enabled}"
                                                Tag="{x:Bind Id}"
                                                Visibility="{x:Bind OffersRemove}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasManaged, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.ManagedHeading, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.ManagedBody, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.ManagedLine, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasChannels, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind l10n:S.MessagingSenderPerChannel}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind l10n:S.MessagingSenderNote}"
                            TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Channels}" Visibility="{x:Bind ViewModel.ChannelsEditable, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChannelSenderItem">
                                    <ComboBox
                                        MinWidth="240"
                                        AutomationProperties.AutomationId="MessagingChannelSender"
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Header="{x:Bind Label}"
                                        ItemsSource="{x:Bind AccountLabels}"
                                        PlaceholderText="{x:Bind SelectedLabel}"
                                        SelectedIndex="{x:Bind SelectedIndex}"
                                        SelectionChanged="OnSenderChosen"
                                        Tag="{x:Bind Channel}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Channels}" Visibility="{x:Bind ViewModel.ChannelsReadOnly, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChannelSenderItem">
                                    <TextBlock Text="{x:Bind Line}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasCreator, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.CreatorHeading, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.CreatorHelp, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox
                                MinWidth="220"
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingMobileNumber}"
                                Header="{x:Bind l10n:S.MessagingMobileNumber}"
                                InputScope="TelephoneNumber"
                                Text="{x:Bind ViewModel.OwnerNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingSaveNumber}"
                                Command="{x:Bind ViewModel.SaveOwnerNumberCommand}"
                                Content="{x:Bind l10n:S.MessagingSaveNumber}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="{x:Bind l10n:S.MessagingSavingNumber}"
                                IsActive="{x:Bind ViewModel.SavingOwnerNumber, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.SavingOwnerNumber, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </views:PageColumn>
    </ScrollViewer>
</UserControl>
