<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Desk.DeskTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels"
    xmlns:desk="using:DistrictAI.ViewModels.Desk">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.ReferenceLine, Mode=OneWay}" />
            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind ViewModel.DatesLine, Mode=OneWay}" />
        </StackPanel>

        <!-- The status buttons: the ticket's own is marked and does nothing. -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Status" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Statuses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="desk:DeskStatusItem">
                        <Button
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            Click="OnStatusClick"
                            IsEnabled="{x:Bind Enabled}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="12"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind Selected}" />
                                <TextBlock Text="{x:Bind Label}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.Name="Changing the status"
                IsActive="{x:Bind ViewModel.StatusChanging, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.StatusChanging, Mode=OneWay}" />
        </StackPanel>

        <views:RefreshStrip x:Name="Refresh" Grid.Row="2" />

        <StackPanel Grid.Row="3" Spacing="4">
            <InfoBar
                AutomationProperties.Name="Problem with this ticket"
                CloseButtonCommand="{x:Bind ViewModel.DismissFailuresCommand}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                Message="{x:Bind ViewModel.Failure, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                AutomationProperties.Name="Reply sent"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNotifiedNote, Mode=OneWay}"
                Message="{x:Bind ViewModel.NotifiedNote, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <ScrollViewer Grid.Row="4" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Customer" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Details}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FactItem">
                            <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Value}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Conversation" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Messages}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="desk:DeskMessageItem">
                            <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                <!-- Written by the workspace's team. -->
                                <Border
                                    MaxWidth="560"
                                    Padding="12,8"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Visibility="{x:Bind FromTeam}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Body}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </Border>
                                <!-- Written by the customer, or by the receptionist. -->
                                <Border
                                    MaxWidth="560"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Visibility="{x:Bind FromOthers}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Body}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Meta}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" Grid.Row="4" />

        <!-- The reply. What was written stays when sending it fails. -->
        <Grid
            Grid.Row="5"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                MaxHeight="160"
                AcceptsReturn="True"
                AutomationProperties.Name="Reply"
                Header="Reply"
                IsEnabled="{x:Bind ViewModel.CanWriteReply, Mode=OneWay}"
                Text="{x:Bind ViewModel.Reply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="Sending the reply"
                    IsActive="{x:Bind ViewModel.Sending, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Sending, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="Send the reply"
                    Command="{x:Bind ViewModel.SendReplyCommand}"
                    Content="Send"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
