<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Desk.DeskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels.Desk">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Help desk settings"
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Content="Settings"
                Visibility="{x:Bind ViewModel.CanOpenSettings, Mode=OneWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="New ticket"
                Command="{x:Bind ViewModel.StartTicketCommand}"
                Content="New ticket"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
        </Grid>

        <!-- The confirmation of a ticket raised, until put away. -->
        <InfoBar
            Grid.Row="1"
            AutomationProperties.Name="Ticket raised"
            CloseButtonCommand="{x:Bind ViewModel.DismissSubmittedCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasSubmitted, Mode=OneWay}"
            Message="{x:Bind ViewModel.Submitted, Mode=OneWay}"
            Severity="Success" />

        <!-- The form raising a ticket for a customer, while it is open. -->
        <Border
            Grid.Row="2"
            MaxWidth="{StaticResource ReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.Composing, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.ComposeTitle, Mode=OneWay}" />
                <TextBox
                    AutomationProperties.Name="Subject"
                    Header="Subject"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="{x:Bind ViewModel.SubjectMax, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    MinHeight="120"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Message"
                    Header="Message"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    MaxLength="{x:Bind ViewModel.MessageMax, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="The customer" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.CustomerNote, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBox
                    AutomationProperties.Name="Customer's name"
                    Header="Name"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Text="{x:Bind ViewModel.RequesterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.Name="Customer's email address"
                    Header="Email address"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Text="{x:Bind ViewModel.RequesterEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.Name="Customer's phone number"
                    Header="Phone number"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                    Text="{x:Bind ViewModel.RequesterPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Needs, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNeeds, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.Name="Ticket not raised"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasComposeFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ComposeFailure, Mode=OneWay}"
                    Severity="Error" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="Raise the ticket"
                        Command="{x:Bind ViewModel.SubmitTicketCommand}"
                        Content="{x:Bind ViewModel.SubmitLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.Name="Discard the ticket"
                        Command="{x:Bind ViewModel.CancelTicketCommand}"
                        Content="Cancel" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Raising the ticket"
                        IsActive="{x:Bind ViewModel.Submitting, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Submitting, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- A desk that is switched off records nothing: it says so, in place of the queue. -->
        <Border
            Grid.Row="3"
            MaxWidth="{StaticResource ReadingWidth}"
            HorizontalAlignment="Left"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.IsOff, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.OffTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.OffBody, Mode=OneWay}" TextWrapping="Wrap" />
                <InfoBar
                    AutomationProperties.Name="The help desk was not turned on"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasEnableFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.EnableFailure, Mode=OneWay}"
                    Severity="Error" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.TurnOnLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.TurnOnCommand}"
                        Content="{x:Bind ViewModel.TurnOnLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Turning on the help desk"
                        IsActive="{x:Bind ViewModel.Enabling, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Enabling, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="4"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.ShowQueue, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                MinWidth="240"
                AutomationProperties.Name="Which tickets to show"
                IsEnabled="{x:Bind ViewModel.CanFilter, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilterLabels}"
                SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="Which tickets to show" />
            <views:RefreshStrip
                x:Name="Refresh"
                Grid.Column="1"
                VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="5" Visibility="{x:Bind ViewModel.ShowQueue, Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.NoneMatching, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasNoneMatching, Mode=OneWay}" />
                <ListView
                    AutomationProperties.Name="Tickets"
                    IsItemClickEnabled="True"
                    ItemClick="OnTicketClick"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeskRowItem">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Subject}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind Line}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                                <!-- A ticket waiting on the workspace stands out; the others are quiet. -->
                                <Border
                                    Grid.Column="1"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Visibility="{x:Bind IsOpen}">
                                    <TextBlock
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusLabel}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource QuietTextStyle}"
                                    Text="{x:Bind StatusLabel}"
                                    Visibility="{x:Bind IsQuiet}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" Grid.Row="5" />
    </Grid>
</UserControl>
