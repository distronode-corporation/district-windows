<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Stretch"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.WorkspaceName, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="8,2"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind ViewModel.HasReadOnlyBadge, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ReadOnlyBadge, Mode=OneWay}" />
                </Border>
                <views:RefreshStrip x:Name="Refresh" />

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasFinishSetup, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.FinishSetupTitle, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.FinishSetupBody, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.Name="{x:Bind ViewModel.FinishSetupAction, Mode=OneWay}"
                                Command="{x:Bind ViewModel.FinishSetupCommand}"
                                Content="{x:Bind ViewModel.FinishSetupAction, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Metrics}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="8"
                                MinItemWidth="160"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactItem">
                                <Border AutomationProperties.Name="{x:Bind AccessibleName}" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Value}" />
                                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Label}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Recent calls" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.RecentCallsEmpty, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NoRecentCalls, Mode=OneWay}" />
                    <ListView
                        AutomationProperties.Name="Recent calls"
                        IsItemClickEnabled="True"
                        ItemClick="OnCallClick"
                        ItemsSource="{x:Bind ViewModel.RecentCalls}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CallRowItem">
                                <Grid
                                    Padding="0,8"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Style="{StaticResource QuietTextStyle}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            MaxLines="2"
                                            Text="{x:Bind Summary}"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasSummary}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind When}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" />
    </Grid>
</UserControl>
