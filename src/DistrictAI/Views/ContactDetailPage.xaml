<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.ContactDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Reach, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasReach, Mode=OneWay}" />
                <!-- A call back, in a build that can carry calls. -->
                <Button
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Call"
                    Command="{x:Bind ViewModel.CallCommand}"
                    Visibility="{x:Bind ViewModel.CanCall, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Phone" />
                        <TextBlock Text="Call" />
                    </StackPanel>
                </Button>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Blocked"
                    Visibility="{x:Bind ViewModel.Changes.Blocked, Mode=OneWay}" />
                <!-- The changes a member may make; a role that may change nothing sees none of them. -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.Changes.Writable, Mode=OneWay}">
                    <Button
                        AutomationProperties.Name="Edit contact"
                        Command="{x:Bind ViewModel.Changes.StartEditCommand}"
                        IsEnabled="{x:Bind ViewModel.Changes.CanEdit, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Edit" />
                            <TextBlock Text="Edit" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.Changes.BlockLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Changes.AskBlockCommand}"
                        Content="{x:Bind ViewModel.Changes.BlockLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Changes.CanBlock, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Delete contact"
                        Command="{x:Bind ViewModel.Changes.AskDeleteCommand}"
                        IsEnabled="{x:Bind ViewModel.Changes.CanDelete, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="You have read-only access to this workspace, so you cannot change contacts."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.Changes.ReadOnly, Mode=OneWay}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.Changes.Busy, Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        AutomationProperties.Name="{x:Bind ViewModel.Changes.BusyText, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.Changes.Busy, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Changes.BusyText, Mode=OneWay}" />
                </StackPanel>
                <InfoBar
                    AutomationProperties.Name="Problem"
                    CloseButtonClick="OnFailureClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                    Severity="Warning" />

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Details" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactItem">
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasNumberFacts, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Phone number" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.NumberFacts}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactItem">
                                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasDossier, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.DossierLabel, Mode=OneWay}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DossierText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.ResearchStatus, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasResearchStatus, Mode=OneWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Changes.Writable, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Research" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="Research looks this contact up on the web and writes a summary. Each run is billed."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.Name="Run research"
                                Command="{x:Bind ViewModel.Changes.EnrichCommand}"
                                Content="Run research"
                                IsEnabled="{x:Bind ViewModel.Changes.CanEnrich, Mode=OneWay}" />
                            <Button
                                AutomationProperties.Name="Clear research"
                                Command="{x:Bind ViewModel.Changes.AskClearResearchCommand}"
                                Content="Clear research"
                                IsEnabled="{x:Bind ViewModel.Changes.CanClearResearch, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Changes.OffersClearResearch, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        Click="OnReportClick"
                        Content="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.ReportEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ReportVisible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" />
    </Grid>
</UserControl>
