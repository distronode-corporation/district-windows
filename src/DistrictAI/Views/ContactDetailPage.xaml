<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.ContactDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Reach, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasReach, Mode=OneWay}" />
                <!-- A call back, in a build that can carry calls. -->
                <Button
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Call"
                    Command="{x:Bind ViewModel.CallCommand}"
                    Visibility="{x:Bind ViewModel.CanCall, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Phone" />
                        <TextBlock Text="Call" />
                    </StackPanel>
                </Button>
                <InfoBar
                    AutomationProperties.Name="Problem"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                    Severity="Warning" />

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Details" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactItem">
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasNumberFacts, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Phone number" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.NumberFacts}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactItem">
                                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasDossier, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.DossierLabel, Mode=OneWay}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DossierText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.ResearchStatus, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasResearchStatus, Mode=OneWay}" />

                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        Click="OnReportClick"
                        Content="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.ReportEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ReportVisible, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" />
    </Grid>
</UserControl>
