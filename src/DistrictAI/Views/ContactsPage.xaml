<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Contacts" />
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasTotalLabel, Mode=OneWay}" />
        </StackPanel>
        <views:RefreshStrip x:Name="Refresh" Grid.Row="1" />
        <ListView
            Grid.Row="2"
            AutomationProperties.Name="Contacts"
            IsItemClickEnabled="True"
            ItemClick="OnContactClick"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ContactRowItem">
                    <StackPanel
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        Spacing="2">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind Detail}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind HasDetail}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Load more contacts"
                        Command="{x:Bind ViewModel.Paging.LoadMoreCommand}"
                        Content="Load more"
                        IsEnabled="{x:Bind ViewModel.Paging.LoadMoreEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.CanLoadMore, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Loading more contacts"
                        IsActive="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Paging.MoreFailureMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        Visibility="{x:Bind ViewModel.Paging.HasMoreFailure, Mode=OneWay}" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="2" />
    </Grid>
</UserControl>
