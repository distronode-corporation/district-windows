<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.HoursOverridesContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
            TextWrapping="Wrap" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="HoursOverridesLoading"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}" />
        <TextBlock
            AutomationProperties.AutomationId="HoursOverridesReadFailure"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />

        <!-- The days still to come, a run of days as one row, while the add form is closed. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsList, Mode=OneWay}">
            <Button
                AutomationProperties.AutomationId="HoursOverrideAdd"
                AutomationProperties.Name="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.AddOverrideCommand}"
                Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="HoursOverridesEmpty"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
            <ItemsRepeater AutomationProperties.AutomationId="HoursOverridesList" ItemsSource="{x:Bind ViewModel.Rows}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="sched:OverrideEntry">
                        <Grid
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Dates}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Hours}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="HoursOverrideDelete"
                                AutomationProperties.Name="{x:Bind DeleteName}"
                                Click="OnDeleteClick"
                                Content="{x:Bind DeleteLabel}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Tag="{x:Bind Key}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <!-- A row's delete, asked once more: a run goes whole, and says how many days. The delete is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="HoursOverrideDeleteTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="HoursOverrideDeleteBody"
                    Text="{x:Bind ViewModel.AskBody, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="HoursOverrideDeleteConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="HoursOverrideDeleteCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The add form, in place of the list: its kind decides its fields. -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Adding, Mode=OneWay}">
            <TextBlock
                AutomationProperties.AutomationId="HoursOverrideFormTitle"
                AutomationProperties.HeadingLevel="Level3"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Words.Title, Mode=OneWay}" />
            <ComboBox
                x:Name="KindChooser"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="HoursOverrideKind"
                AutomationProperties.Name="{x:Bind ViewModel.Words.KindLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.KindLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Kinds}"
                SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=OneWay}"
                SelectionChanged="OnKindChanged" />
            <TextBox
                AutomationProperties.AutomationId="HoursOverrideDate"
                AutomationProperties.Name="{x:Bind ViewModel.DateLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.DateLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.Words.DatePlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                AutomationProperties.AutomationId="HoursOverrideLastDay"
                AutomationProperties.HelpText="{x:Bind ViewModel.Words.LastDayHint, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Words.LastDayLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.LastDayLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.Words.DatePlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.ShowsLastDay, Mode=OneWay}">
                <TextBox.Description>
                    <TextBlock Text="{x:Bind ViewModel.Words.LastDayHint, Mode=OneWay}" TextWrapping="Wrap" />
                </TextBox.Description>
            </TextBox>

            <!-- Custom hours: one day, with the hours it opens and closes. -->
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowsHours, Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Words.HoursLabel, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        Width="88"
                        AutomationProperties.AutomationId="HoursOverrideStart"
                        AutomationProperties.Name="{x:Bind ViewModel.StartName, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.Words.StartPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Start, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Words.ToLabel, Mode=OneWay}" />
                    <TextBox
                        Width="88"
                        AutomationProperties.AutomationId="HoursOverrideEnd"
                        AutomationProperties.Name="{x:Bind ViewModel.EndName, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.Words.EndPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.End, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                AutomationProperties.AutomationId="HoursOverrideValidation"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Validation, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasValidation, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="HoursOverrideCancel"
                    AutomationProperties.Name="{x:Bind ViewModel.Words.CancelLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CancelOverrideCommand}"
                    Content="{x:Bind ViewModel.Words.CancelLabel, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="HoursOverrideSave"
                    AutomationProperties.Name="{x:Bind ViewModel.Words.SaveLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveOverrideCommand}"
                    Content="{x:Bind ViewModel.Words.SaveLabel, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="HoursOverridesNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingHoursNotice}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="HoursOverridesFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="HoursOverridesWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
