<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.ReassignBookingContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="360" Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.Dialog.Body, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.HostLabel, Mode=OneWay}" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Hosts.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Hosts.Loading, Mode=OneWay}" />
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Hosts.Failed, Mode=OneWay}">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Hosts.FailureMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="ReassignBookingTryAgain"
                AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                Command="{x:Bind ViewModel.Hosts.RetryCommand}"
                Content="{x:Bind l10n:S.CommonTryAgain}"
                Visibility="{x:Bind ViewModel.Hosts.CanRetry, Mode=OneWay}" />
        </StackPanel>
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Hosts.EmptyText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Hosts.ShowEmpty, Mode=OneWay}" />
        <ScrollViewer MaxHeight="240" Visibility="{x:Bind ViewModel.Hosts.HasChoices, Mode=OneWay}">
            <RadioButtons
                x:Name="HostChooser"
                AutomationProperties.AutomationId="ReassignBookingHosts"
                AutomationProperties.Name="{x:Bind ViewModel.HostLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Hosts.Choices}"
                SelectedIndex="{x:Bind ViewModel.Hosts.SelectedIndex, Mode=OneWay}"
                SelectionChanged="OnHostChanged" />
        </ScrollViewer>
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
