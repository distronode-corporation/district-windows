<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.CancelBookingContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="360" Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.Dialog.Body, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBox
            x:Name="ReasonBox"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="CancelBookingReason"
            AutomationProperties.Name="{x:Bind ViewModel.ReasonLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.ReasonLabel, Mode=OneWay}"
            MinHeight="80"
            Text="{x:Bind ViewModel.Reason, Mode=OneWay}"
            TextChanged="OnReasonChanged"
            TextWrapping="Wrap">
            <TextBox.Description>
                <TextBlock Text="{x:Bind ViewModel.ReasonHint, Mode=OneWay}" TextWrapping="Wrap" />
            </TextBox.Description>
        </TextBox>
        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.ReasonRejected, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasReasonRejected, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
