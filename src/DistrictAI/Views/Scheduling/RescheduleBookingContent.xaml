<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.RescheduleBookingContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="360" Spacing="12">
        <TextBlock Text="{x:Bind ViewModel.Dialog.Body, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind ViewModel.TimesIn, Mode=OneWay}" />
        <CalendarDatePicker
            x:Name="DayPicker"
            AutomationProperties.AutomationId="RescheduleBookingDay"
            AutomationProperties.Name="{x:Bind ViewModel.DayLabel, Mode=OneWay}"
            Date="{x:Bind ViewModel.DayDate, Mode=OneWay}"
            DateChanged="OnDayChanged"
            Header="{x:Bind ViewModel.DayLabel, Mode=OneWay}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.TimeLabel, Mode=OneWay}" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Slots.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Slots.Loading, Mode=OneWay}" />
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Slots.Failed, Mode=OneWay}">
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Slots.FailureMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                Command="{x:Bind ViewModel.Slots.RetryCommand}"
                Content="{x:Bind l10n:S.CommonTryAgain}"
                Visibility="{x:Bind ViewModel.Slots.CanRetry, Mode=OneWay}" />
        </StackPanel>
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Slots.EmptyText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Slots.ShowEmpty, Mode=OneWay}" />
        <ScrollViewer MaxHeight="240" Visibility="{x:Bind ViewModel.Slots.HasChoices, Mode=OneWay}">
            <RadioButtons
                x:Name="SlotChooser"
                AutomationProperties.AutomationId="RescheduleBookingTimes"
                AutomationProperties.Name="{x:Bind ViewModel.TimeLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Slots.Choices}"
                SelectedIndex="{x:Bind ViewModel.Slots.SelectedIndex, Mode=OneWay}"
                SelectionChanged="OnSlotChanged" />
        </ScrollViewer>
        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.SelectionRejected, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasSelectionRejected, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
