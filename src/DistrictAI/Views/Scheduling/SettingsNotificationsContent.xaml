<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SettingsNotificationsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <!-- As an attendee, then as a host: a switch each, saved together by the dialog's confirm. -->
        <ItemsRepeater AutomationProperties.AutomationId="SettingsNotifyGroups" ItemsSource="{x:Bind ViewModel.Groups}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sched:NotificationGroupEntry">
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level3"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Heading}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind Description}"
                            TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind Switches}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sched:NotificationSwitchEntry">
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Header="{x:Bind Label}"
                                        IsEnabled="{x:Bind Enabled}"
                                        IsOn="{x:Bind On}"
                                        Tag="{x:Bind Field}"
                                        Toggled="OnToggled" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <InfoBar
            AutomationProperties.AutomationId="SettingsNotificationsNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingSettingsNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="SettingsNotificationsFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="SettingsNotificationsWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
