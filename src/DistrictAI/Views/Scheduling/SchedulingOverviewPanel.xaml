<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SchedulingOverviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <ScrollViewer AutomationProperties.AutomationId="SchedulingOverview">
        <views:PageColumn>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Spacing="12">
                <TextBlock
                    AutomationProperties.AutomationId="SchedulingOverviewTimesIn"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.TimesIn, Mode=OneWay}" />

                <!-- The booking desk: five rows, each labelled in every state, each standing or falling alone. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.DeskHeading, Mode=OneWay}" />
                        <ItemsRepeater AutomationProperties.AutomationId="SchedulingDesk" ItemsSource="{x:Bind ViewModel.Desk}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sched:DeskEntry">
                                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="LoadingRing"
                                            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                                            IsActive="{x:Bind IsLoading}"
                                            Visibility="{x:Bind IsLoading}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsFailed}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsValue}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource QuietTextStyle}"
                                            Text="{x:Bind More}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind HasMore}" />
                                        <TextBlock
                                            Style="{StaticResource QuietTextStyle}"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsHint}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- What is coming up. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.ComingUpHeading, Mode=OneWay}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="LoadingRing"
                            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                            IsActive="{x:Bind ViewModel.ComingUpLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ComingUpLoading, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ComingUpFailure, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasComingUpFailure, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind ViewModel.ComingUpEmpty, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ShowComingUpEmpty, Mode=OneWay}" />
                        <ItemsRepeater AutomationProperties.AutomationId="SchedulingComingUp" ItemsSource="{x:Bind ViewModel.ComingUp}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="sched:ComingUpEntry">
                                    <Grid AutomationProperties.Name="{x:Bind AccessibleName}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind When}" />
                                            <TextBlock
                                                Style="{StaticResource QuietTextStyle}"
                                                Text="{x:Bind Subtitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusLabel}"
                                            Visibility="{x:Bind IsSuccess}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusLabel}"
                                            Visibility="{x:Bind IsDanger}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusLabel}"
                                            Visibility="{x:Bind IsNeutral}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </views:PageColumn>
    </ScrollViewer>
</UserControl>
