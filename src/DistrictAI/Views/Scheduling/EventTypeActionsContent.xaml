<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.EventTypeActionsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="360" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.AutomationId="EventTypeActionsToggle"
                AutomationProperties.Name="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleCommand}"
                Content="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}" />
            <Button
                AutomationProperties.AutomationId="EventTypeActionsArchive"
                AutomationProperties.Name="{x:Bind ViewModel.ArchiveLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.ArchiveCommand}"
                Content="{x:Bind ViewModel.ArchiveLabel, Mode=OneWay}" />
        </StackPanel>

        <!-- The stored wording of each email, sent to the member. -->
        <TextBlock
            AutomationProperties.HeadingLevel="Level3"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.TestEmailHeading, Mode=OneWay}" />
        <ItemsRepeater AutomationProperties.AutomationId="EventTypeTestEmails" ItemsSource="{x:Bind ViewModel.TestEmails}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sched:ChoiceEntry">
                    <HyperlinkButton
                        AutomationProperties.AutomationId="EventTypeTestEmail"
                        AutomationProperties.Name="{x:Bind Label}"
                        Click="OnTestEmailClick"
                        Content="{x:Bind Label}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Button
            AutomationProperties.AutomationId="EventTypeActionsDelete"
            AutomationProperties.Name="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}"
            Command="{x:Bind ViewModel.AskDeleteCommand}"
            Content="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

        <!-- The delete, asked once more: what goes, and what stays. The delete is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="EventTypeDeleteTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AskBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="EventTypeDeleteConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="EventTypeDeleteCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar
            AutomationProperties.AutomationId="EventTypeActionsNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingEventTypeNotice}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="EventTypeActionsFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventTypeActionsWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
