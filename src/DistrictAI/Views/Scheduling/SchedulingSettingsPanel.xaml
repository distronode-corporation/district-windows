<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SchedulingSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling"
    xmlns:views="using:DistrictAI.Views">
    <Grid>
        <ScrollViewer AutomationProperties.AutomationId="SchedulingSettings">
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                HorizontalAlignment="Left"
                Spacing="12">
                <!-- The four tabs: each read the first time it shows. -->
                <RadioButtons
                    x:Name="TabChooser"
                    AutomationProperties.AutomationId="SchedulingSettingsTabs"
                    AutomationProperties.Name="{x:Bind l10n:S.SchedulingSettingsTabs}"
                    MaxColumns="4"
                    SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=OneWay}"
                    SelectionChanged="OnTabChanged">
                    <RadioButton
                        AutomationProperties.AutomationId="SchedulingSettingsTabBookingPage"
                        AutomationProperties.Name="{x:Bind ViewModel.BookingPageLabel, Mode=OneWay}"
                        Content="{x:Bind ViewModel.BookingPageLabel, Mode=OneWay}" />
                    <RadioButton
                        AutomationProperties.AutomationId="SchedulingSettingsTabAssistant"
                        AutomationProperties.Name="{x:Bind ViewModel.AssistantLabel, Mode=OneWay}"
                        Content="{x:Bind ViewModel.AssistantLabel, Mode=OneWay}" />
                    <RadioButton
                        AutomationProperties.AutomationId="SchedulingSettingsTabProfile"
                        AutomationProperties.Name="{x:Bind ViewModel.ProfileLabel, Mode=OneWay}"
                        Content="{x:Bind ViewModel.ProfileLabel, Mode=OneWay}" />
                    <RadioButton
                        AutomationProperties.AutomationId="SchedulingSettingsTabNotifications"
                        AutomationProperties.Name="{x:Bind ViewModel.NotificationsLabel, Mode=OneWay}"
                        Content="{x:Bind ViewModel.NotificationsLabel, Mode=OneWay}" />
                </RadioButtons>

                <!-- The tab's read: a failed one is a status page, and "Try again" reads only the tab. -->
                <views:StatusPanel x:Name="Status" HorizontalAlignment="Left" />

                <ItemsRepeater
                    AutomationProperties.AutomationId="SchedulingSettingsGroups"
                    ItemsSource="{x:Bind ViewModel.Groups}"
                    Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:SettingsGroupEntry">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SectionHeaderStyle}"
                                        Text="{x:Bind Heading}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasDescription}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Rows}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="sched:SettingsRowEntry">
                                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" Spacing="2">
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                                    <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- The tab's dialog: the booking page's and the assistant's need a member who may change things. -->
                <Button
                    AutomationProperties.AutomationId="SchedulingSettingsEdit"
                    AutomationProperties.Name="{x:Bind ViewModel.EditLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.OpenEditorCommand}"
                    Content="{x:Bind ViewModel.EditLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.OffersEdit, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
