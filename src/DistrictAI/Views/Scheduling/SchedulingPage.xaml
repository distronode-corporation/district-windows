<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SchedulingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Booking pages" />
        <views:RefreshStrip x:Name="Refresh" Grid.Row="1" />

        <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                HorizontalAlignment="Left"
                Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                Glyph="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="640"
                                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasBookingUrl, Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Booking page" />
                            <TextBlock
                                AutomationProperties.Name="Booking page"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.BookingUrl, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasLastLive, Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Last live" />
                            <TextBlock AutomationProperties.Name="Last live" Text="{x:Bind ViewModel.LastLive, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="What went wrong" />
                            <TextBlock
                                AutomationProperties.Name="What went wrong"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Problem, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar
                    AutomationProperties.Name="Booking pages problem"
                    CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Warning" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        AutomationProperties.Name="Turn on booking pages"
                        Command="{x:Bind ViewModel.EnableCommand}"
                        Content="Turn on booking pages"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.OffersEnable, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Check again"
                        Command="{x:Bind ViewModel.CheckAgainCommand}"
                        Content="Check again"
                        Visibility="{x:Bind ViewModel.OffersCheck, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Manage on the web"
                        Command="{x:Bind ViewModel.ManageOnWebCommand}"
                        Content="Manage on the web"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.OffersWeb, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Working"
                        IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="Opens the booking pages on the District AI website in your browser, signed in as you."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.OffersWeb, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" Grid.Row="2" />
    </Grid>
</UserControl>
