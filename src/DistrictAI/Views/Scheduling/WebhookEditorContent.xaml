<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.WebhookEditorContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <!-- The form, until a new webhook's signing secret shows. -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowsForm, Mode=OneWay}">
            <!-- Where it posts: typed for an add, fixed once added. -->
            <TextBox
                AutomationProperties.AutomationId="DeveloperWebhookUrl"
                AutomationProperties.HelpText="{x:Bind ViewModel.Words.UrlHint, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Words.UrlLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.UrlLabel, Mode=OneWay}"
                InputScope="Url"
                IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.Creating, Mode=OneWay}">
                <TextBox.Description>
                    <TextBlock Text="{x:Bind ViewModel.Words.UrlHint, Mode=OneWay}" TextWrapping="Wrap" />
                </TextBox.Description>
            </TextBox>
            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.Changing, Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Words.UrlLabel, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="DeveloperWebhookUrlFixed"
                    AutomationProperties.HelpText="{x:Bind ViewModel.Words.UrlHint, Mode=OneWay}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Url, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Words.UrlHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                AutomationProperties.AutomationId="DeveloperWebhookUrlError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.UrlError, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasUrlError, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="DeveloperWebhookDropped"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.Dropped, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasDropped, Mode=OneWay}" />

            <!-- The events it sends, by their names on the wire. -->
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Words.EventsLabel, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Words.EventsHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ItemsRepeater AutomationProperties.AutomationId="DeveloperWebhookEvents" ItemsSource="{x:Bind ViewModel.Events}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:ToggleEntry">
                            <CheckBox
                                AutomationProperties.AutomationId="{x:Bind EventAutomationId}"
                                AutomationProperties.Name="{x:Bind AccessibleName}"
                                Click="OnEventClick"
                                Content="{x:Bind Value}"
                                IsChecked="{x:Bind On}"
                                IsEnabled="{x:Bind Enabled}"
                                Tag="{x:Bind Value}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    AutomationProperties.AutomationId="DeveloperWebhookEventsError"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.EventsError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasEventsError, Mode=OneWay}" />
            </StackPanel>

            <!-- The parts of a booking each delivery carries, a person's own data marked. -->
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.Words.FieldsLabel, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Words.FieldsHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ItemsRepeater AutomationProperties.AutomationId="DeveloperWebhookFields" ItemsSource="{x:Bind ViewModel.Fields}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:ToggleEntry">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox
                                    AutomationProperties.AutomationId="{x:Bind FieldAutomationId}"
                                    AutomationProperties.Name="{x:Bind AccessibleName}"
                                    Click="OnFieldClick"
                                    Content="{x:Bind Value}"
                                    IsChecked="{x:Bind On}"
                                    IsEnabled="{x:Bind Enabled}"
                                    Tag="{x:Bind Value}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Mark}"
                                    Visibility="{x:Bind HasMark}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>

        <!-- A new webhook's signing secret, shown once: copied only when asked, and gone when the dialog closes. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Shown.IsShown, Mode=OneWay}">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Shown.Warning, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.Shown.Note, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Shown.HasNote, Mode=OneWay}" />
            <TextBox
                AutomationProperties.AutomationId="DeveloperSecretValue"
                AutomationProperties.Name="{x:Bind ViewModel.Dialog.Title, Mode=OneWay}"
                FontFamily="Consolas"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.Shown.Value, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="DeveloperSecretCopy"
                AutomationProperties.Name="{x:Bind ViewModel.Shown.CopyLabel, Mode=OneWay}"
                Click="OnCopyClick"
                Content="{x:Bind ViewModel.Shown.CopyLabel, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="DeveloperSecretCopyFailed"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind l10n:S.SchedulingCopyFailed}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Shown.CopyFailed, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="DeveloperWebhookNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingWebhookNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="DeveloperWebhookFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="DeveloperWebhookWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
