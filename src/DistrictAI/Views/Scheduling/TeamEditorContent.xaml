<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.TeamEditorContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="400" Spacing="12">
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Words.Hint, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBox
            AutomationProperties.AutomationId="TeamEditorName"
            AutomationProperties.Name="{x:Bind ViewModel.Words.NameLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.NameLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            PlaceholderText="{x:Bind ViewModel.Words.NamePlaceholder, Mode=OneWay}"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            AutomationProperties.AutomationId="TeamEditorNameError"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.NameError, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasNameError, Mode=OneWay}" />

        <!-- A team's own: its address stays, and its delete is apart from the rename. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsDelete, Mode=OneWay}">
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.SlugHint, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="TeamDeleteButton"
                AutomationProperties.Name="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.AskDeleteCommand}"
                Content="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- The delete, asked once more: what goes with the team. The delete is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="TeamDeleteTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AskBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="TeamDeleteConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="TeamDeleteCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar
            AutomationProperties.AutomationId="TeamEditorNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingTeamNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="TeamEditorFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="TeamEditorWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
