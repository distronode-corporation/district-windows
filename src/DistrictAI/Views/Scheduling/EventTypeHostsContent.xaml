<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.EventTypeHostsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventTypeHostsLoading"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}" />
        <TextBlock
            AutomationProperties.AutomationId="EventTypeHostsReadFailure"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
        <Button
            AutomationProperties.AutomationId="EventTypeHostsRetry"
            AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
            Command="{x:Bind ViewModel.RetryCommand}"
            Content="{x:Bind l10n:S.CommonTryAgain}"
            Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />

        <!-- Only a list that was read can be saved: the scheduler replaces it whole. -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Ready, Mode=OneWay}">
            <ComboBox
                x:Name="RoutingChooser"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="EventTypeHostsRouting"
                AutomationProperties.Name="{x:Bind ViewModel.RoutingLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.RoutingLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.RoutingModes}"
                SelectedIndex="{x:Bind ViewModel.RoutingIndex, Mode=OneWay}"
                SelectionChanged="OnRoutingChanged" />
            <ComboBox
                x:Name="RotationChooser"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="EventTypeHostsRotation"
                AutomationProperties.HelpText="{x:Bind ViewModel.RotationHint, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.RotationLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.RotationLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Rotations}"
                SelectedIndex="{x:Bind ViewModel.RotationIndex, Mode=OneWay}"
                SelectionChanged="OnRotationChanged"
                Visibility="{x:Bind ViewModel.ShowsRotation, Mode=OneWay}">
                <ComboBox.Description>
                    <TextBlock Text="{x:Bind ViewModel.RotationHint, Mode=OneWay}" TextWrapping="Wrap" />
                </ComboBox.Description>
            </ComboBox>

            <TextBlock
                AutomationProperties.AutomationId="EventTypeHostsEmpty"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
            <ItemsRepeater AutomationProperties.AutomationId="EventTypeHostsList" ItemsSource="{x:Bind ViewModel.Hosts}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="sched:HostEntry">
                        <!--
                            The host's name and address across the dialog's whole width, and
                            its controls on a row of their own in the same columns for every
                            host: beside the controls the name was cut and the address broken
                            mid-word at 200 percent text, and the combo boxes did not line up.
                        -->
                        <Grid
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ColumnSpacing="8"
                            RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.ColumnSpan="3"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind Email}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Email}" />
                            <ComboBox
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EventTypeHostRole"
                                AutomationProperties.Name="{x:Bind RoleName}"
                                ItemsSource="{x:Bind Roles}"
                                SelectedIndex="{x:Bind RoleIndex}"
                                SelectionChanged="OnRoleChanged"
                                Tag="{x:Bind UserId}" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="96"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EventTypeHostPriority"
                                AutomationProperties.Name="{x:Bind PriorityName}"
                                InputScope="Number"
                                PlaceholderText="{x:Bind PriorityLabel}"
                                Tag="{x:Bind UserId}"
                                Text="{x:Bind Priority}"
                                TextChanged="OnPriorityChanged"
                                ToolTipService.ToolTip="{x:Bind PriorityLabel}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EventTypeHostRemove"
                                AutomationProperties.Name="{x:Bind RemoveName}"
                                Click="OnRemoveClick"
                                Content="{x:Bind RemoveLabel}"
                                Tag="{x:Bind UserId}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Who could be added, read after the hosts: being read, or a read that failed, with Try again. The hosts stay editable. -->
            <ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="EventTypeHostCandidatesLoading"
                AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                IsActive="{x:Bind ViewModel.CandidatesLoad.Loading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.CandidatesLoad.Loading, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CandidatesLoad.Failed, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.AutomationId="EventTypeHostCandidatesFailure"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.CandidatesLoad.FailureMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    AutomationProperties.AutomationId="EventTypeHostCandidatesRetry"
                    AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                    Command="{x:Bind ViewModel.CandidatesLoad.RetryCommand}"
                    Content="{x:Bind l10n:S.CommonTryAgain}"
                    Visibility="{x:Bind ViewModel.CandidatesLoad.CanRetry, Mode=OneWay}" />
            </StackPanel>

            <!-- The scheduler's users who are not hosts yet and not archived. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasCandidates, Mode=OneWay}">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind l10n:S.SchedulingHostsAdd}" />
                <ItemsRepeater AutomationProperties.AutomationId="EventTypeHostCandidates" ItemsSource="{x:Bind ViewModel.Candidates}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:CandidateEntry">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="EventTypeHostAdd"
                                    AutomationProperties.Name="{x:Bind AddName}"
                                    Click="OnAddClick"
                                    Content="{x:Bind AddLabel}"
                                    Tag="{x:Bind UserId}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>

        <TextBlock
            AutomationProperties.AutomationId="EventTypeHostsValidation"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Validation, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasValidation, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.AutomationId="EventTypeHostsFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventTypeHostsWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
