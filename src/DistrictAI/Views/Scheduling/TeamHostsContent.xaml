<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.TeamHostsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            AutomationProperties.AutomationId="TeamHostsEmpty"
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />

        <!-- The team as last answered: each host saves on their own. -->
        <ItemsRepeater AutomationProperties.AutomationId="TeamHostsList" views:SnapshotItems.Source="{x:Bind ViewModel.Hosts}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sched:TeamHostEntry">
                    <Grid
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind Email}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox
                            Grid.Column="1"
                            Width="72"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TeamHostPriority"
                            AutomationProperties.Name="{x:Bind PriorityName}"
                            InputScope="Number"
                            PlaceholderText="{x:Bind PriorityLabel}"
                            Tag="{x:Bind UserId}"
                            Text="{x:Bind Priority}"
                            TextChanged="OnPriorityChanged"
                            ToolTipService.ToolTip="{x:Bind PriorityLabel}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TeamHostSave"
                            AutomationProperties.Name="{x:Bind SaveName}"
                            Click="OnSaveClick"
                            Content="{x:Bind SaveLabel}"
                            Tag="{x:Bind UserId}" />
                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TeamHostRemove"
                            AutomationProperties.Name="{x:Bind RemoveName}"
                            Click="OnRemoveClick"
                            Content="{x:Bind RemoveLabel}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Tag="{x:Bind UserId}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <TextBlock
            AutomationProperties.AutomationId="TeamPriorityError"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.PriorityError, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasPriorityError, Mode=OneWay}" />

        <!-- A removal, asked once more: the host's place in the rotation goes. The removal is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="TeamRemoveTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AskBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="TeamRemoveConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmRemoveCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="TeamRemoveCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelRemoveCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The scheduler's users who are not in the team and not archived: one is picked, and Add member adds them. -->
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="TeamUsersLoading"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.UsersLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.UsersLoading, Mode=OneWay}" />
        <TextBlock
            AutomationProperties.AutomationId="TeamUsersFailure"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.UsersFailure, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.UsersFailed, Mode=OneWay}" />
        <TextBlock
            AutomationProperties.AutomationId="TeamAddNone"
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.AddNone, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasAddNone, Mode=OneWay}" />
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasCandidates, Mode=OneWay}">
            <RadioButtons
                x:Name="CandidateChooser"
                AutomationProperties.AutomationId="TeamCandidates"
                AutomationProperties.HelpText="{x:Bind ViewModel.AddPlaceholder, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Candidates}"
                SelectedIndex="{x:Bind ViewModel.PickedIndex, Mode=OneWay}"
                SelectionChanged="OnCandidateChanged">
                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="sched:ChoiceEntry">
                        <RadioButton
                            AutomationProperties.AutomationId="TeamCandidate"
                            AutomationProperties.Name="{x:Bind Label}"
                            Content="{x:Bind Label}" />
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.AddPlaceholder, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="TeamHostsNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingTeamNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="TeamHostsFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="TeamHostsWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
