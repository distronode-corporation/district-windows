<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SchedulingBookingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling"
    xmlns:views="using:DistrictAI.Views">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            AutomationProperties.AutomationId="SchedulingBookingsTimesIn"
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.TimesIn, Mode=OneWay}" />
        <RadioButtons
            x:Name="TabChooser"
            Grid.Row="1"
            AutomationProperties.AutomationId="SchedulingBookingsViews"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingBookingsViews}"
            ItemsSource="{x:Bind ViewModel.Tabs}"
            MaxColumns="4"
            SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
            SelectionChanged="OnTabChanged" />
        <InfoBar
            Grid.Row="2"
            AutomationProperties.AutomationId="SchedulingBookingsNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingChangeNotice}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand, Mode=OneWay}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />

        <ListView
            Grid.Row="3"
            AutomationProperties.AutomationId="SchedulingBookingsList"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingBookingsViews}"
            IsItemClickEnabled="True"
            ItemClick="OnBookingClick"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="sched:BookingEntry">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind When}" />
                            <TextBlock
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind Subtitle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind Email}"
                                Visibility="{x:Bind HasEmail}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusLabel}"
                            Visibility="{x:Bind IsSuccess}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusLabel}"
                            Visibility="{x:Bind IsWarning}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusLabel}"
                            Visibility="{x:Bind IsDanger}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusLabel}"
                            Visibility="{x:Bind IsNeutral}" />
                        <!-- The writes the core offers on the booking, under it. -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind HasActions}">
                            <Button
                                AutomationProperties.AutomationId="BookingCancelButton"
                                AutomationProperties.Name="{x:Bind CancelLabel}"
                                Click="OnCancelClick"
                                Content="{x:Bind CancelLabel}"
                                Visibility="{x:Bind CanCancel}" />
                            <Button
                                AutomationProperties.AutomationId="BookingRescheduleButton"
                                AutomationProperties.Name="{x:Bind RescheduleLabel}"
                                Click="OnRescheduleClick"
                                Content="{x:Bind RescheduleLabel}"
                                Visibility="{x:Bind CanReschedule}" />
                            <Button
                                AutomationProperties.AutomationId="BookingReassignButton"
                                AutomationProperties.Name="{x:Bind ReassignLabel}"
                                Click="OnReassignClick"
                                Content="{x:Bind ReassignLabel}"
                                Visibility="{x:Bind CanReassign}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="SchedulingBookingsLoadMore"
                        AutomationProperties.Name="{x:Bind ViewModel.LoadMoreLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Paging.LoadMoreCommand, Mode=OneWay}"
                        Content="{x:Bind ViewModel.LoadMoreLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.Paging.LoadMoreEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.CanLoadMore, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="{x:Bind ViewModel.LoadMoreLabel, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Paging.MoreFailureMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Paging.HasMoreFailure, Mode=OneWay}" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="3" />
    </Grid>
</UserControl>
