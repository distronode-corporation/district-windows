<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SchedulingEventTypesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling"
    xmlns:views="using:DistrictAI.Views">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Offered to a member who may change things, over a list that was read. -->
        <Button
            AutomationProperties.AutomationId="EventTypeCreateButton"
            AutomationProperties.Name="{x:Bind ViewModel.CreateLabel, Mode=OneWay}"
            Command="{x:Bind ViewModel.OpenCreateCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.CreateLabel, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind ViewModel.OffersCreate, Mode=OneWay}" />

        <ListView
            Grid.Row="1"
            AutomationProperties.AutomationId="SchedulingEventTypesList"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingEventTypesList}"
            IsItemClickEnabled="True"
            ItemClick="OnEventTypeClick"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="sched:EventTypeEntry">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name}"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Subtitle}" />
                            <TextBlock
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind BookingPage}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StateLabel}"
                            Visibility="{x:Bind IsSuccess}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind StateLabel}"
                            Visibility="{x:Bind IsNeutral}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="1" />
    </Grid>
</UserControl>
