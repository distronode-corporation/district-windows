<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.TeamArchiveContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="400" Spacing="12">
        <TextBlock
            AutomationProperties.AutomationId="TeamArchiveBody"
            Text="{x:Bind ViewModel.Dialog.Body, Mode=OneWay}"
            TextWrapping="Wrap" />
        <!-- Why Archive account is off: still counting, or bookings to move first. -->
        <TextBlock
            AutomationProperties.AutomationId="TeamArchiveBlocked"
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Blocked, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasBlocked, Mode=OneWay}" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="TeamUpcomingLoading"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}" />
        <!-- A count that failed is never "none": Archive account stays off. -->
        <TextBlock
            AutomationProperties.AutomationId="TeamUpcomingFailure"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
        <ItemsRepeater AutomationProperties.AutomationId="TeamUpcomingList" ItemsSource="{x:Bind ViewModel.Bookings}">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="sched:UpcomingBookingEntry">
                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}" Spacing="2">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind EventType}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind Attendee}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind When}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- The archive, asked once more. The archive is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="TeamArchiveAskTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AskBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="TeamArchiveConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmArchiveCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="TeamArchiveCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelArchiveCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar
            AutomationProperties.AutomationId="TeamArchiveNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingTeamNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="TeamArchiveFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="TeamArchiveWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
