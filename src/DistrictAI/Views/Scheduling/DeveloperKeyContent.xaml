<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.DeveloperKeyContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="400" Spacing="12">
        <!-- The name, until the key is made. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsForm, Mode=OneWay}">
            <TextBox
                AutomationProperties.AutomationId="DeveloperKeyName"
                AutomationProperties.HelpText="{x:Bind ViewModel.NameHint, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                Description="{x:Bind ViewModel.NameHint, Mode=OneWay}"
                Header="{x:Bind ViewModel.NameLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                AutomationProperties.AutomationId="DeveloperKeyNameError"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.NameError, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNameError, Mode=OneWay}" />
        </StackPanel>

        <!-- The key, shown once: copied only when asked, and gone when the dialog closes. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Shown.IsShown, Mode=OneWay}">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Shown.Warning, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBox
                AutomationProperties.AutomationId="DeveloperSecretValue"
                AutomationProperties.Name="{x:Bind ViewModel.Dialog.Title, Mode=OneWay}"
                FontFamily="Consolas"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.Shown.Value, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="DeveloperSecretCopy"
                AutomationProperties.Name="{x:Bind ViewModel.Shown.CopyLabel, Mode=OneWay}"
                Click="OnCopyClick"
                Content="{x:Bind ViewModel.Shown.CopyLabel, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="DeveloperSecretCopyFailed"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind l10n:S.SchedulingCopyFailed}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Shown.CopyFailed, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="DeveloperKeyFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="DeveloperKeyWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
