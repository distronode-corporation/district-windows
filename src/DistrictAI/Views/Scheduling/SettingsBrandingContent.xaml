<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.SettingsBrandingContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel MinWidth="440" Spacing="12">
        <TextBox
            AutomationProperties.AutomationId="SettingsBusinessName"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.BusinessNameHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.BusinessNameLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.BusinessNameLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Text="{x:Bind ViewModel.BusinessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Description>
                <TextBlock Text="{x:Bind ViewModel.Words.BusinessNameHint, Mode=OneWay}" TextWrapping="Wrap" />
            </TextBox.Description>
        </TextBox>
        <NumberBox
            AutomationProperties.AutomationId="SettingsLogoHeight"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.LogoHeightHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.LogoHeightLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.LogoHeightLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Maximum="{x:Bind ViewModel.LogoHeightMaximum, Mode=OneWay}"
            Minimum="{x:Bind ViewModel.LogoHeightMinimum, Mode=OneWay}"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.LogoHeight, Mode=TwoWay}">
            <NumberBox.Description>
                <TextBlock Text="{x:Bind ViewModel.Words.LogoHeightHint, Mode=OneWay}" TextWrapping="Wrap" />
            </NumberBox.Description>
        </NumberBox>
        <NumberBox
            AutomationProperties.AutomationId="SettingsLogoOpacity"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.OpacityHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.LogoOpacityLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.LogoOpacityLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Maximum="{x:Bind ViewModel.OpacityMaximum, Mode=OneWay}"
            Minimum="{x:Bind ViewModel.OpacityMinimum, Mode=OneWay}"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.LogoOpacity, Mode=TwoWay}" />
        <NumberBox
            AutomationProperties.AutomationId="SettingsBannerOpacity"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.OpacityHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.BannerOpacityLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.BannerOpacityLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Maximum="{x:Bind ViewModel.OpacityMaximum, Mode=OneWay}"
            Minimum="{x:Bind ViewModel.OpacityMinimum, Mode=OneWay}"
            SpinButtonPlacementMode="Inline"
            Value="{x:Bind ViewModel.BannerOpacity, Mode=TwoWay}">
            <NumberBox.Description>
                <TextBlock Text="{x:Bind ViewModel.Words.OpacityHint, Mode=OneWay}" TextWrapping="Wrap" />
            </NumberBox.Description>
        </NumberBox>
        <TextBox
            AutomationProperties.AutomationId="SettingsPrivacyUrl"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.LegalUrlHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.PrivacyLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.PrivacyLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Text="{x:Bind ViewModel.PrivacyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox
            AutomationProperties.AutomationId="SettingsTermsUrl"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.LegalUrlHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.TermsLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.TermsLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            Text="{x:Bind ViewModel.TermsUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Description>
                <TextBlock Text="{x:Bind ViewModel.Words.LegalUrlHint, Mode=OneWay}" TextWrapping="Wrap" />
            </TextBox.Description>
        </TextBox>
        <ComboBox
            x:Name="LocaleChooser"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="SettingsLocale"
            AutomationProperties.HelpText="{x:Bind ViewModel.Words.LocaleHint, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Words.LocaleLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.Words.LocaleLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Locales}"
            SelectedIndex="{x:Bind ViewModel.LocaleIndex, Mode=OneWay}"
            SelectionChanged="OnLocaleChanged">
            <ComboBox.Description>
                <TextBlock Text="{x:Bind ViewModel.Words.LocaleHint, Mode=OneWay}" TextWrapping="Wrap" />
            </ComboBox.Description>
        </ComboBox>
        <TextBlock
            AutomationProperties.AutomationId="SettingsBrandingError"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Error, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <!-- The images: each saves as soon as it is chosen or removed, apart from the dialog's save. -->
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Words.ImagesNote, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.Words.ImageHint, Mode=OneWay}"
            TextWrapping="Wrap" />
        <Border x:Name="LogoHost" />
        <Border x:Name="BannerHost" />

        <InfoBar
            AutomationProperties.AutomationId="SettingsBrandingNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingSettingsNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="SettingsBrandingFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="SettingsBrandingWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
