<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.CalendarPickerContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                AutomationProperties.AutomationId="CalendarPickerLoading"
                AutomationProperties.Name="{x:Bind ViewModel.LoadingLabel, Mode=OneWay}"
                IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.LoadingLabel, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}">
            <TextBlock
                AutomationProperties.AutomationId="CalendarPickerReadFailure"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="CalendarPickerRetry"
                AutomationProperties.Name="{x:Bind l10n:S.CommonTryAgain}"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="{x:Bind l10n:S.CommonTryAgain}"
                Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
        </StackPanel>

        <!-- Only calendars that were read can be saved: the scheduler takes them whole. -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Ready, Mode=OneWay}">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.ConflictsLabel, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.ConflictsHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ItemsRepeater AutomationProperties.AutomationId="CalendarPickerConflicts" views:SnapshotItems.Source="{x:Bind ViewModel.Calendars}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:CalendarRowEntry">
                            <CheckBox
                                AutomationProperties.AutomationId="CalendarConflict"
                                AutomationProperties.Name="{x:Bind ConflictsName}"
                                Click="OnConflictClick"
                                Content="{x:Bind Name}"
                                IsChecked="{x:Bind ChecksConflicts}"
                                IsEnabled="{x:Bind Enabled}"
                                Tag="{x:Bind Id}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            <StackPanel Spacing="4">
                <RadioButtons
                    x:Name="DestinationChooser"
                    AutomationProperties.AutomationId="CalendarPickerDestination"
                    AutomationProperties.Name="{x:Bind ViewModel.DestinationLabel, Mode=OneWay}"
                    Header="{x:Bind ViewModel.DestinationLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Editable, Mode=OneWay}"
                    views:SnapshotItems.Source="{x:Bind ViewModel.Destinations}"
                    views:SnapshotItems.SelectedIndex="{x:Bind ViewModel.DestinationIndex, Mode=OneWay}"
                    SelectionChanged="OnDestinationChanged">
                    <RadioButtons.ItemTemplate>
                        <DataTemplate x:DataType="sched:ChoiceEntry">
                            <RadioButton
                                AutomationProperties.AutomationId="CalendarDestination"
                                AutomationProperties.Name="{x:Bind Label}"
                                Content="{x:Bind Label}" />
                        </DataTemplate>
                    </RadioButtons.ItemTemplate>
                </RadioButtons>
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.DestinationHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="CalendarPickerNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingCalendarNotice}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="CalendarPickerFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="CalendarPickerWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
