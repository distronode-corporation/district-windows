<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Scheduling.EventTypeQuestionsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:sched="using:DistrictAI.ViewModels.Scheduling">
    <StackPanel MinWidth="440" Spacing="12">
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventTypeQuestionsLoading"
            AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
            IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Loading, Mode=OneWay}" />
        <TextBlock
            AutomationProperties.AutomationId="EventTypeQuestionsReadFailure"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />

        <!-- The list, in the order the booker sees it, while no question's form is open. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsList, Mode=OneWay}">
            <Button
                AutomationProperties.AutomationId="EventTypeQuestionAdd"
                AutomationProperties.Name="{x:Bind ViewModel.AddLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.AddQuestionCommand}"
                Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="EventTypeQuestionsEmpty"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay}" />
            <ItemsRepeater AutomationProperties.AutomationId="EventTypeQuestionsList" views:SnapshotItems.Source="{x:Bind ViewModel.Questions}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="sched:QuestionEntry">
                        <Grid
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            AutomationProperties.Name="{x:Bind AccessibleName}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Value}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EventTypeQuestionEdit"
                                AutomationProperties.Name="{x:Bind EditName}"
                                Click="OnEditClick"
                                Content="{x:Bind EditLabel}"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EventTypeQuestionDelete"
                                AutomationProperties.Name="{x:Bind DeleteName}"
                                Click="OnDeleteClick"
                                Content="{x:Bind DeleteLabel}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <!-- A question's delete, asked once more. The delete is never the default. -->
        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.Asking, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="EventTypeQuestionDeleteTitle"
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.AskTitle, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.AskBody, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="EventTypeQuestionDeleteConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                        Content="{x:Bind ViewModel.AskConfirm, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Button
                        AutomationProperties.AutomationId="EventTypeQuestionDeleteCancel"
                        AutomationProperties.Name="{x:Bind ViewModel.AskCancel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}"
                        Content="{x:Bind ViewModel.AskCancel, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- One question's form, in place of the list. -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Editing, Mode=OneWay}">
            <TextBlock
                AutomationProperties.AutomationId="EventTypeQuestionFormTitle"
                AutomationProperties.HeadingLevel="Level3"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.Words.Title, Mode=OneWay}" />
            <TextBox
                AutomationProperties.AutomationId="EventTypeQuestionLabel"
                AutomationProperties.Name="{x:Bind ViewModel.Words.LabelLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.LabelLabel, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.Words.LabelPlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                x:Name="KindChooser"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="EventTypeQuestionKind"
                AutomationProperties.Name="{x:Bind ViewModel.Words.TypeLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.TypeLabel, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Kinds}"
                SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=OneWay}"
                SelectionChanged="OnKindChanged" />
            <ToggleSwitch
                AutomationProperties.AutomationId="EventTypeQuestionRequired"
                AutomationProperties.Name="{x:Bind ViewModel.Words.RequiredLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.RequiredLabel, Mode=OneWay}"
                IsOn="{x:Bind ViewModel.Required, Mode=TwoWay}" />
            <TextBox
                AutomationProperties.AutomationId="EventTypeQuestionPosition"
                AutomationProperties.Name="{x:Bind ViewModel.Words.PositionLabel, Mode=OneWay}"
                Header="{x:Bind ViewModel.Words.PositionLabel, Mode=OneWay}"
                InputScope="Number"
                Text="{x:Bind ViewModel.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Description>
                    <TextBlock Text="{x:Bind ViewModel.Words.PositionHint, Mode=OneWay}" TextWrapping="Wrap" />
                </TextBox.Description>
            </TextBox>

            <!-- A select's choices: the core's, added and taken off through it. -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowsOptions, Mode=OneWay}">
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Words.OptionsLabel, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Words.OptionsHint, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ItemsRepeater AutomationProperties.AutomationId="EventTypeQuestionOptions" views:SnapshotItems.Source="{x:Bind ViewModel.Options}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="sched:OptionEntry">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Option}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="EventTypeQuestionRemoveOption"
                                    AutomationProperties.Name="{x:Bind RemoveName}"
                                    Click="OnRemoveOptionClick"
                                    Content="{x:Bind RemoveLabel}"
                                    Tag="{x:Bind Option}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="EventTypeQuestionNewOption"
                        AutomationProperties.Name="{x:Bind ViewModel.Words.OptionPlaceholder, Mode=OneWay}"
                        KeyDown="OnNewOptionKeyDown"
                        PlaceholderText="{x:Bind ViewModel.Words.OptionPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.NewOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="EventTypeQuestionAddOption"
                        AutomationProperties.Name="{x:Bind ViewModel.Words.AddOptionLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.AddOptionCommand}"
                        Content="{x:Bind ViewModel.Words.AddOptionLabel, Mode=OneWay}" />
                </Grid>
            </StackPanel>

            <TextBlock
                AutomationProperties.AutomationId="EventTypeQuestionValidation"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.Validation, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasValidation, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="EventTypeQuestionCancel"
                    AutomationProperties.Name="{x:Bind ViewModel.Words.CancelLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.CancelQuestionCommand}"
                    Content="{x:Bind ViewModel.Words.CancelLabel, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="EventTypeQuestionSave"
                    AutomationProperties.Name="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SaveQuestionCommand}"
                    Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            AutomationProperties.AutomationId="EventTypeQuestionsNotice"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingEventTypeNotice}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Success" />
        <InfoBar
            AutomationProperties.AutomationId="EventTypeQuestionsFailure"
            AutomationProperties.Name="{x:Bind l10n:S.SchedulingProblem}"
            CloseButtonCommand="{x:Bind ViewModel.DismissNoticeCommand}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.Dialog.HasFailure, Mode=OneWay}"
            Message="{x:Bind ViewModel.Dialog.Failure, Mode=OneWay}"
            Severity="Error" />
        <ProgressRing
            Width="20"
            Height="20"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="EventTypeQuestionsWorking"
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsActive="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Dialog.Working, Mode=OneWay}" />
    </StackPanel>
</UserControl>
