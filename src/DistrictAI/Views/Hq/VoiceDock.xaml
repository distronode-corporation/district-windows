<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Hq.VoiceDock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hq="using:DistrictAI.Views.Hq"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:views="using:DistrictAI.Views"
    AutomationProperties.AutomationId="VoiceDock"
    AutomationProperties.LandmarkType="Custom"
    AutomationProperties.LocalizedLandmarkType="{x:Bind ViewModel.Title, Mode=OneWay}"
    AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
    Visibility="{x:Bind ViewModel.IsShown, Mode=OneWay}">
    <StackPanel
        x:Name="Dock"
        Padding="24,8"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1"
        Spacing="8">
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextWrapping="WrapWholeWords" />
        <!-- The line, and its buttons beside it, or under it when a narrow window leaves the line too little room. -->
        <views:StatusRow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.Voice.Line, Mode=OneWay}"
                    IsActive="{x:Bind ViewModel.Voice.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Voice.IsBusy, Mode=OneWay}" />
                <!-- What the assistant is doing, or why the session ended: plain text, never Markdown. -->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="VoiceDockLine"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Voice.Line, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.Voice.ShowsNews, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.Voice.Line, Mode=OneWay}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ViewModel.Voice.ShowsProblem, Mode=OneWay}" />
            </Grid>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="DockDismiss"
                    AutomationProperties.AutomationId="VoiceDockDismiss"
                    AutomationProperties.Name="{x:Bind l10n:S.CommonDismiss}"
                    Command="{x:Bind ViewModel.Voice.DismissCommand}"
                    ToolTipService.ToolTip="{x:Bind l10n:S.CommonDismiss}"
                    Visibility="{x:Bind ViewModel.Voice.CanDismiss, Mode=OneWay}">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
                <ToggleButton
                    AutomationProperties.AutomationId="VoiceDockMicrophone"
                    AutomationProperties.Name="{x:Bind l10n:S.CallBarMute}"
                    IsChecked="{x:Bind ViewModel.Voice.Muted, Mode=TwoWay}"
                    ToolTipService.ToolTip="{x:Bind l10n:S.CallBarMute}"
                    Visibility="{x:Bind ViewModel.Voice.ShowMicrophone, Mode=OneWay}">
                    <SymbolIcon Symbol="Microphone" />
                </ToggleButton>
                <Button
                    x:Name="DockStop"
                    AutomationProperties.AutomationId="VoiceDockStop"
                    AutomationProperties.Name="{x:Bind ViewModel.Voice.StopLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.Voice.StopCommand}"
                    Content="{x:Bind ViewModel.Voice.StopLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Voice.CanStop, Mode=OneWay}" />
            </StackPanel>
        </views:StatusRow>
        <!-- Why a card went without a result; the dismiss button above puts it away. -->
        <TextBlock
            AutomationProperties.LiveSetting="Assertive"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Voice.Notice, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Voice.HasNotice, Mode=OneWay}" />
        <!--
            Each change in full, to confirm or cancel here. Tall cards scroll
            inside the dock rather than push the page away: at most 320 high,
            less in a short window (LimitCards), so two cards and a call strip
            above them never put Confirm and Cancel out of reach.
        -->
        <ScrollViewer
            x:Name="DockCardScroll"
            MaxHeight="320"
            AutomationProperties.AutomationId="VoiceDockCards"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.Voice.HasCards, Mode=OneWay}">
            <hq:VoiceCards x:Name="DockCards" />
        </ScrollViewer>
        <HyperlinkButton
            x:Name="DockReview"
            AutomationProperties.AutomationId="VoiceDockReview"
            AutomationProperties.Name="{x:Bind ViewModel.ReviewLabel, Mode=OneWay}"
            Command="{x:Bind ViewModel.ReviewCommand}"
            Content="{x:Bind ViewModel.ReviewLabel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.CanReview, Mode=OneWay}" />
    </StackPanel>
</UserControl>
