<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n">
    <StackPanel
        MaxWidth="440"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="16">
        <TextBlock
            AutomationProperties.AutomationId="SignInTitle"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" TextWrapping="Wrap" />
        <!-- Another copy of the app is installed: which one this is, and why sign-in is held. -->
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.CopyLine, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasCopyLine, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="{x:Bind ViewModel.HeldTitle, Mode=OneWay}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.SignInHeld, Mode=OneWay}"
            Message="{x:Bind ViewModel.HeldMessage, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind ViewModel.HeldTitle, Mode=OneWay}" />
        <ProgressRing
            AutomationProperties.Name="Working"
            IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="Sign-in problem"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.AutomationId="SignInButton"
                AutomationProperties.Name="{x:Bind l10n:S.SignInWithBrowser}"
                Command="{x:Bind ViewModel.SignInCommand}"
                Content="{x:Bind l10n:S.SignInWithBrowser}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.CanSignIn, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.CreateAccountLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.CreateAccountCommand}"
                Content="{x:Bind ViewModel.CreateAccountLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanCreateAccount, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.OffersCreateAccount, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="Try again"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="Try again"
                Visibility="{x:Bind ViewModel.CanRetry, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="Sign out again"
                Command="{x:Bind ViewModel.RetrySignOutCommand}"
                Content="Sign out again"
                Visibility="{x:Bind ViewModel.CanRetrySignOut, Mode=OneWay}" />
            <Button
                AutomationProperties.Name="Cancel"
                Command="{x:Bind ViewModel.CancelCommand}"
                Content="Cancel"
                Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
        </StackPanel>
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.CreateAccountNote, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.OffersCreateAccount, Mode=OneWay}" />
        <!--
          SPIKE (do not merge): a static x:Bind inside a DataTemplate with
          x:DataType, next to an instance x:Bind to the row; and what each
          language API said at start-up, for SpikeL10nTests to read.
        -->
        <ItemsControl ItemsSource="{x:Bind l10n:SpikeRow.All}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="l10n:SpikeRow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock AutomationProperties.AutomationId="SpikeTemplateText" Text="{x:Bind l10n:S.SpikeTemplateText}" />
                        <TextBlock AutomationProperties.AutomationId="SpikeTemplateRow" Text="{x:Bind Label}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
            AutomationProperties.AutomationId="SpikeLanguages"
            FontSize="9"
            Text="{x:Bind l10n:SpikeLanguages.Report}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
