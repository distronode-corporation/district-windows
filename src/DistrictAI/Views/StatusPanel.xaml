<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.StatusPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Loading, a load that failed, or nothing to show: whichever applies, centred where the content would be. -->
    <StackPanel
        MaxWidth="480"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <ProgressRing
            AutomationProperties.Name="Loading"
            IsActive="{x:Bind State.Loading, Mode=OneWay}"
            Visibility="{x:Bind State.Loading, Mode=OneWay}" />
        <StackPanel Spacing="8" Visibility="{x:Bind State.Failed, Mode=OneWay}">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind State.FailureMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind State.RegionsLine, Mode=OneWay}"
                TextAlignment="Center"
                Visibility="{x:Bind State.HasRegionsLine, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.Name="Try again"
                Command="{x:Bind State.RetryCommand}"
                Content="Try again"
                Visibility="{x:Bind State.CanRetry, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{x:Bind State.ShowEmpty, Mode=OneWay}">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind State.EmptyTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind State.EmptyBody, Mode=OneWay}"
                TextAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
