<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Marketplace.MarketplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:marketplace="using:DistrictAI.Views.Marketplace"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels.Marketplace">
    <UserControl.Resources>
        <DataTemplate x:Key="NumberRowTemplate" x:DataType="vm:NumberRowItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Number}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind Line}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Monthly}"
                    Visibility="{x:Bind HasMonthly}" />
            </Grid>
        </DataTemplate>
        <!-- A held number, with what can be done to it: the core says what, and asks before a release. -->
        <DataTemplate x:Key="OwnedRowTemplate" x:DataType="vm:NumberRowItem">
            <Grid
                Padding="0,8"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="12"
                RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Number}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind Line}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Monthly}"
                    Visibility="{x:Bind HasMonthly}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ManageNote}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasManageNote}" />
                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind Manageable}">
                    <Button
                        AutomationProperties.AutomationId="NumberConfigure"
                        AutomationProperties.Name="{x:Bind ConfigureLabel}"
                        Click="OnConfigureClick"
                        Content="{x:Bind ConfigureLabel}"
                        IsEnabled="{x:Bind CanConfigure}" />
                    <Button
                        AutomationProperties.AutomationId="NumberRelease"
                        AutomationProperties.Name="{x:Bind ReleaseLabel}"
                        Click="OnReleaseClick"
                        Content="{x:Bind ReleaseLabel}"
                        IsEnabled="{x:Bind CanRelease}" />
                    <ProgressRing
                        Width="16"
                        Height="16"
                        AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
                        IsActive="{x:Bind Busy}"
                        Visibility="{x:Bind Busy}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind l10n:S.NumbersTitle}" />
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.ScopeNote, Mode=OneWay}"
                TextWrapping="Wrap" />
            <!-- The scope note above already says numbers are bought on the web: the link has no caption repeating it. -->
            <HyperlinkButton
                Padding="0,4"
                AutomationProperties.Name="{x:Bind ViewModel.WebAction, Mode=OneWay}"
                Command="{x:Bind ViewModel.OpenWebCommand}"
                Content="{x:Bind ViewModel.WebAction, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.OffersWeb, Mode=OneWay}" />
        </StackPanel>

        <views:TabStrip
            x:Name="TabChooser"
            Grid.Row="1"
            AutomationProperties.AutomationId="NumbersTabs"
            AutomationProperties.Name="{x:Bind l10n:S.NumbersShow}"
            ItemsSource="{x:Bind marketplace:MarketplacePage.TabsOf(ViewModel.Admin.CarrierTab), Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.TabIndex, Mode=OneWay}" />

        <!-- The numbers the workspace holds. -->
        <views:RefreshStrip
            x:Name="Refresh"
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.OnOwned, Mode=OneWay}" />
        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.OnOwned, Mode=OneWay}">
            <ScrollViewer Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.PartialNote, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasPartialNote, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Text="{x:Bind ViewModel.Admin.NumberNotice, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Admin.HasNumberNotice, Mode=OneWay}" />
                    <ListView
                        AutomationProperties.AutomationId="OwnedNumbers"
                        AutomationProperties.Name="{x:Bind l10n:S.NumbersYours}"
                        ItemTemplate="{StaticResource OwnedRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Owned}"
                        SelectionMode="None" />
                    <!-- The billed lookup: the core asks before it runs. -->
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Bind ViewModel.Admin.LookupEyebrow, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox
                            MinWidth="220"
                            AutomationProperties.AutomationId="LookupNumber"
                            AutomationProperties.Name="{x:Bind ViewModel.Admin.LookupLabel, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Admin.LookupLabel, Mode=OneWay}"
                            InputScope="TelephoneNumber"
                            Text="{x:Bind ViewModel.Admin.LookupNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="{x:Bind ViewModel.Admin.LookupAction, Mode=OneWay}"
                            Command="{x:Bind ViewModel.Admin.AskLookupCommand}"
                            Content="{x:Bind ViewModel.Admin.LookupAction, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Admin.LookupResult, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Admin.HasLookupResult, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
            <views:StatusPanel x:Name="Status" />
        </Grid>

        <!-- The carrier tab: read when it opens. -->
        <marketplace:CarrierPanel
            x:Name="CarrierPanel"
            Grid.Row="2"
            Grid.RowSpan="2"
            Visibility="{x:Bind ViewModel.Admin.OnCarrier, Mode=OneWay}" />

        <!-- The search of the numbers for sale. -->
        <Grid
            Grid.Row="2"
            Grid.RowSpan="2"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.OnSearch, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox
                    MinWidth="120"
                    AutomationProperties.Name="{x:Bind l10n:S.NumbersAreaCode}"
                    Header="{x:Bind l10n:S.NumbersAreaCode}"
                    InputScope="Number"
                    KeyDown="OnSearchKeyDown"
                    Text="{x:Bind ViewModel.AreaCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    MinWidth="120"
                    AutomationProperties.Name="{x:Bind l10n:S.NumbersCountryCode}"
                    Header="{x:Bind l10n:S.NumbersCountryCode}"
                    KeyDown="OnSearchKeyDown"
                    Text="{x:Bind ViewModel.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    MinWidth="140"
                    AutomationProperties.Name="{x:Bind l10n:S.NumbersNumberType}"
                    Header="{x:Bind l10n:S.NumbersNumberType}"
                    ItemsSource="{x:Bind ViewModel.TypeLabels}"
                    SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}" />
                <Button
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="{x:Bind l10n:S.NumbersSearchA11y}"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="{x:Bind l10n:S.NumbersSearch}" />
            </StackPanel>
            <Grid Grid.Row="1">
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind l10n:S.NumbersSearchHint}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.SearchIdle, Mode=OneWay}" />
                <ProgressRing
                    AutomationProperties.Name="{x:Bind l10n:S.CommonSearching}"
                    IsActive="{x:Bind ViewModel.Searching, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Searching, Mode=OneWay}" />
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFound, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="{x:Bind l10n:S.NumbersForSale}" />
                    <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind ViewModel.ProviderLine, Mode=OneWay}" />
                    <ListView
                        AutomationProperties.Name="{x:Bind l10n:S.NumbersForSale}"
                        ItemTemplate="{StaticResource NumberRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Found}"
                        SelectionMode="None" />
                </StackPanel>
                <StackPanel
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasSearchStatus, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.SearchStatusTitle, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.SearchStatusBody, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Bind l10n:S.NumbersRetrySearch}"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Content="{x:Bind l10n:S.CommonTryAgain}"
                        Visibility="{x:Bind ViewModel.CanRetrySearch, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
