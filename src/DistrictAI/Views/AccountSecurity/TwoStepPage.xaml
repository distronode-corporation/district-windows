<UserControl
    x:Class="DistrictAI.Views.AccountSecurity.TwoStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    xmlns:views="using:DistrictAI.Views">
    <ScrollViewer>
        <views:PageColumn>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="12">
                <TextBlock
                    AutomationProperties.AutomationId="TwoStepHeading"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <InfoBar
                    AutomationProperties.AutomationId="TwoStepProblem"
                    AutomationProperties.Name="{x:Bind ViewModel.Failure, Mode=OneWay}"
                    CloseButtonClick="OnNoticesClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Failure, Mode=OneWay}"
                    Severity="Error" />
                <InfoBar
                    AutomationProperties.AutomationId="TwoStepNotice"
                    AutomationProperties.Name="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    CloseButtonClick="OnNoticesClosed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Success" />
                <ProgressBar
                    AutomationProperties.AutomationId="TwoStepBusy"
                    AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />

                <!-- The first read. -->
                <ProgressRing
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="LoadingRing"
                    AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="TwoStepRetry"
                    AutomationProperties.Name="{x:Bind ViewModel.RetryLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="{x:Bind ViewModel.RetryLabel, Mode=OneWay}"
                    ContentTemplate="{StaticResource WrappingLabelTemplate}"
                    IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadFailed, Mode=OneWay}" />

                <!-- The status, and the change it offers. -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsOverview, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="TwoStepStatus"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusLabel, Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="TwoStepStatusLines"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.StatusLines, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="TwoStepTurnOn"
                        AutomationProperties.Name="{x:Bind ViewModel.OfferedLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.BeginCommand}"
                        Content="{x:Bind ViewModel.OfferedLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.OffersTurnOn, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="TwoStepTurnOff"
                        AutomationProperties.Name="{x:Bind ViewModel.OfferedLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.BeginCommand}"
                        Content="{x:Bind ViewModel.OfferedLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.OffersTurnOff, Mode=OneWay}" />
                </StackPanel>

                <!-- Confirming it is you, before either change. -->
                <ContentControl
                    x:Name="ReauthHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsTabStop="False" />

                <!-- The new secret: shown only on its step, dropped when the page is left. -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsScan, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="TwoStepScanHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ScanIntro, Mode=OneWay}" TextWrapping="Wrap" />
                    <Image
                        x:Name="QrImage"
                        Width="192"
                        Height="192"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="TwoStepQr"
                        AutomationProperties.Name="{x:Bind ViewModel.QrLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasQr, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.QrUnreadable, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowsQrUnreadable, Mode=OneWay}" />
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.KeyLabel, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TwoStepKey"
                            AutomationProperties.HelpText="{x:Bind ViewModel.KeyLabel, Mode=OneWay}"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Key, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Side by side while they fit, one under the other in French or a narrow window. -->
                    <views:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button
                            AutomationProperties.AutomationId="TwoStepCopyKey"
                            AutomationProperties.Name="{x:Bind ViewModel.CopyKeyLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopyKeyCommand}"
                            Content="{x:Bind ViewModel.CopyKeyLabel, Mode=OneWay}"
                            ContentTemplate="{StaticResource WrappingLabelTemplate}"
                            IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="TwoStepOpen"
                            AutomationProperties.Name="{x:Bind ViewModel.OpenLabel, Mode=OneWay}"
                            Click="OnOpenClick"
                            Content="{x:Bind ViewModel.OpenLabel, Mode=OneWay}"
                            ContentTemplate="{StaticResource WrappingLabelTemplate}"
                            IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}" />
                    </views:WrapPanel>
                    <TextBlock
                        AutomationProperties.AutomationId="TwoStepOpenFailed"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.OpenFailed, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowsOpenFailed, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.CodePrompt, Mode=OneWay}" TextWrapping="Wrap" />
                    <!-- Never bound: read once by Turn on, then emptied. -->
                    <TextBox
                        x:Name="CodeInput"
                        MaxWidth="320"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="TwoStepCode"
                        AutomationProperties.Name="{x:Bind ViewModel.CodeLabel, Mode=OneWay}"
                        Header="{x:Bind ViewModel.CodeLabel, Mode=OneWay}"
                        InputScope="Number"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        KeyDown="OnCodeKeyDown" />
                    <Button
                        AutomationProperties.AutomationId="TwoStepConfirm"
                        AutomationProperties.Name="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}"
                        Click="OnConfirmClick"
                        Content="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        AutomationProperties.AutomationId="TwoStepBack"
                        AutomationProperties.Name="{x:Bind ViewModel.BackLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Content="{x:Bind ViewModel.BackLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}" />
                </StackPanel>

                <!-- The recovery codes, shown this once. -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCodes, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.AutomationId="TwoStepCodesHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.CodesTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.CodesWarning, Mode=OneWay}" TextWrapping="Wrap" />
                    <Border HorizontalAlignment="Left" Style="{StaticResource CardStyle}">
                        <TextBlock
                            AutomationProperties.AutomationId="TwoStepCodes"
                            AutomationProperties.HelpText="{x:Bind ViewModel.CodesTitle, Mode=OneWay}"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Codes, Mode=OneWay}" />
                    </Border>
                    <Button
                        AutomationProperties.AutomationId="TwoStepCopyCodes"
                        AutomationProperties.Name="{x:Bind ViewModel.CopyAllLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CopyCodesCommand}"
                        Content="{x:Bind ViewModel.CopyAllLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="TwoStepCodesDone"
                        AutomationProperties.Name="{x:Bind ViewModel.DoneLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.FinishRecoveryCodesCommand}"
                        Content="{x:Bind ViewModel.DoneLabel, Mode=OneWay}"
                        ContentTemplate="{StaticResource WrappingLabelTemplate}"
                        IsEnabled="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </views:PageColumn>
    </ScrollViewer>
</UserControl>
