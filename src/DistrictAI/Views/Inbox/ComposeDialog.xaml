<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DistrictAI.Views.Inbox.ComposeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inbox="using:DistrictAI.ViewModels.Inbox"
    xmlns:l10n="using:DistrictAI.L10n"
    AutomationProperties.AutomationId="ComposeDialog"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">
    <!-- The core holds the form: each field goes to it as it changes, and it says when the message can be sent. -->
    <StackPanel MinWidth="400" Spacing="12">
        <!-- Choosing a recipient: a recent contact, or what is typed. -->
        <StackPanel Spacing="8" Visibility="{x:Bind Form.Choosing, Mode=OneWay}">
            <TextBox
                AutomationProperties.AutomationId="ComposeTo"
                AutomationProperties.Name="{x:Bind Form.ToLabel, Mode=OneWay}"
                Header="{x:Bind Form.ToLabel, Mode=OneWay}"
                InputScope="EmailNameOrAddress"
                IsEnabled="{x:Bind Form.Editable, Mode=OneWay}"
                Text="{x:Bind Form.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                AutomationProperties.AutomationId="ComposeUseTyped"
                Command="{x:Bind Form.UseTypedCommand}"
                Content="{x:Bind Form.TypedAction, Mode=OneWay}"
                Visibility="{x:Bind Form.HasTypedAction, Mode=OneWay}" />
            <ProgressRing
                AutomationProperties.Name="{x:Bind l10n:S.CommonLoading}"
                IsActive="{x:Bind Form.ContactsLoading, Mode=OneWay}"
                Visibility="{x:Bind Form.ContactsLoading, Mode=OneWay}" />
            <ListView
                MaxHeight="240"
                AutomationProperties.AutomationId="ComposeSuggestions"
                AutomationProperties.Name="{x:Bind Form.ToLabel, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="OnSuggestionClick"
                ItemsSource="{x:Bind Form.Suggestions}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="inbox:ComposeSuggestionItem">
                        <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind Name}">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind Form.RecentNote, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind Form.SuggestionsFailed, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Form.HasSuggestionsFailed, Mode=OneWay}" />
        </StackPanel>

        <!-- A recipient chosen: the channel, a subject for an email, the message. -->
        <StackPanel Spacing="8" Visibility="{x:Bind Form.Chosen, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind Form.ToLabel, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ComposeRecipient"
                    Text="{x:Bind Form.Recipient, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ComposeChange"
                    Command="{x:Bind Form.ClearRecipientCommand}"
                    Content="{x:Bind Form.ChangeLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind Form.Editable, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind Form.NoAddressNote, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Form.HasNoAddressNote, Mode=OneWay}" />
            <ComboBox
                AutomationProperties.AutomationId="ComposeChannel"
                AutomationProperties.Name="{x:Bind Form.SendOnLabel, Mode=OneWay}"
                Header="{x:Bind Form.SendOnLabel, Mode=OneWay}"
                IsEnabled="{x:Bind Form.Editable, Mode=OneWay}"
                ItemsSource="{x:Bind Form.Channels}"
                SelectedIndex="{x:Bind Form.Channel, Mode=TwoWay}"
                Visibility="{x:Bind Form.HasChannels, Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="inbox:ComposeChannelItem">
                        <StackPanel AutomationProperties.Name="{x:Bind Name}" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource QuietTextStyle}" Text="{x:Bind Address}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox
                AutomationProperties.AutomationId="ComposeSubject"
                AutomationProperties.Name="{x:Bind Form.SubjectLabel, Mode=OneWay}"
                Header="{x:Bind Form.SubjectLabel, Mode=OneWay}"
                IsEnabled="{x:Bind Form.Editable, Mode=OneWay}"
                Text="{x:Bind Form.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind Form.RequiresSubject, Mode=OneWay}" />
            <TextBox
                MinHeight="120"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="ComposeBody"
                AutomationProperties.Name="{x:Bind Form.MessageLabel, Mode=OneWay}"
                Header="{x:Bind Form.MessageLabel, Mode=OneWay}"
                IsEnabled="{x:Bind Form.Editable, Mode=OneWay}"
                Text="{x:Bind Form.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar
            AutomationProperties.Name="{x:Bind l10n:S.CommonWorking}"
            IsIndeterminate="True"
            Visibility="{x:Bind Form.Sending, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.Name="{x:Bind l10n:S.CommonProblem}"
            IsClosable="False"
            IsOpen="{x:Bind Form.HasFailure, Mode=OneWay}"
            Message="{x:Bind Form.Failure, Mode=OneWay}"
            Severity="Error" />
    </StackPanel>
</ContentDialog>
