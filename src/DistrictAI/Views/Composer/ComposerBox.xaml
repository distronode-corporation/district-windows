<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.Composer.ComposerBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composer="using:DistrictAI.ViewModels.Composer"
    xmlns:l10n="using:DistrictAI.L10n">
    <!-- The reply box under a conversation: shown only to a member who may reply there. -->
    <StackPanel
        AutomationProperties.Name="{x:Bind l10n:S.ComposerReply}"
        Spacing="8"
        Visibility="{x:Bind ViewModel.Visible, Mode=OneWay}">

        <!-- Why the last send, upload or AI draft failed, or why a picked file was refused. -->
        <Grid
            Padding="12,8"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            ColumnSpacing="8"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.HasFailure, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Assertive"
                Text="{x:Bind ViewModel.Failure, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind l10n:S.ComposerDismissError}"
                Command="{x:Bind ViewModel.DismissFailureCommand}"
                Content="{x:Bind l10n:S.CommonDismiss}" />
        </Grid>

        <!-- The channel the reply goes on, when the service lists more than one. -->
        <ComboBox
            MinWidth="200"
            AutomationProperties.AutomationId="ReplyChannel"
            AutomationProperties.Name="{x:Bind ViewModel.ChannelLabel, Mode=OneWay}"
            Header="{x:Bind ViewModel.ChannelLabel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanChooseChannel, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Channels}"
            SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.ShowChannels, Mode=OneWay}" />

        <!-- WhatsApp's closed window: only an approved template can go. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WhatsApp.Visible, Mode=OneWay}">
            <InfoBar
                AutomationProperties.AutomationId="WhatsAppWindowClosed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.WhatsApp.HasWindowClosed, Mode=OneWay}"
                Message="{x:Bind ViewModel.WhatsApp.WindowClosed, Mode=OneWay}"
                Severity="Warning" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource QuietTextStyle}"
                Text="{x:Bind ViewModel.WhatsApp.Message, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.WhatsApp.HasMessage, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.WhatsApp.ShowPicker, Mode=OneWay}">
                <ComboBox
                    MinWidth="280"
                    AutomationProperties.AutomationId="TemplatePicker"
                    AutomationProperties.Name="{x:Bind ViewModel.WhatsApp.Label, Mode=OneWay}"
                    Header="{x:Bind ViewModel.WhatsApp.Label, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.WhatsApp.Options}"
                    PlaceholderText="{x:Bind ViewModel.WhatsApp.Placeholder, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.WhatsApp.SelectedTemplate, Mode=TwoWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.WhatsApp.Variables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="composer:TemplateVariableField">
                            <StackPanel Padding="0,0,0,8" Spacing="2">
                                <TextBox
                                    AutomationProperties.AutomationId="TemplateVariable"
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Header="{x:Bind Label}"
                                    Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Required, Mode=OneWay}"
                                    Visibility="{x:Bind HasRequired, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.WhatsApp.HasPreview, Mode=OneWay}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.WhatsApp.PreviewLabel, Mode=OneWay}" />
                    <Border
                        Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock
                            AutomationProperties.AutomationId="TemplatePreview"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.WhatsApp.Preview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Button
                    AutomationProperties.AutomationId="SendTemplate"
                    AutomationProperties.Name="{x:Bind ViewModel.WhatsApp.SendLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.WhatsApp.SendCommand}"
                    Content="{x:Bind ViewModel.WhatsApp.SendLabel, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- A reply the model wrote, in the box for the member to read and edit before sending. -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasAiDraft, Mode=OneWay}">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DraftLabel, Mode=OneWay}" />
            <HyperlinkButton
                Padding="4,2"
                AutomationProperties.Name="{x:Bind ViewModel.DraftReportLabel, Mode=OneWay}"
                Click="OnReportDraftClick"
                Content="{x:Bind ViewModel.DraftReportLabel, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.DraftReportEnabled, Mode=OneWay}" />
        </StackPanel>

        <!-- The images waiting to go with the message. -->
        <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments}" Visibility="{x:Bind ViewModel.HasAttachments, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="composer:AttachmentChip">
                    <Border
                        Padding="8,2,2,2"
                        AutomationProperties.Name="{x:Bind Name}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="14"
                                Glyph="&#xEB9F;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            <Button
                                Padding="6,2"
                                AutomationProperties.Name="{x:Bind RemoveLabel}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRemoveAttachmentClick"
                                ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Why Send waits: the images go by text message only. -->
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.AttachmentsNote, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.HasAttachmentsNote, Mode=OneWay}" />

        <!-- Enter is a new line; Ctrl+Enter sends. -->
        <TextBox
            x:Name="Box"
            MaxHeight="200"
            AcceptsReturn="True"
            AutomationProperties.AutomationId="ReplyBox"
            AutomationProperties.HelpText="{x:Bind l10n:S.ComposerHelp}"
            AutomationProperties.Name="{x:Bind l10n:S.ComposerReply}"
            IsReadOnly="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
            IsSpellCheckEnabled="True"
            PlaceholderText="{x:Bind l10n:S.ComposerPlaceholder}"
            PreviewKeyDown="OnBoxPreviewKeyDown"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowText, Mode=OneWay}" />

        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowText, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                AutomationProperties.Name="{x:Bind l10n:S.ComposerAttachImage}"
                Click="OnAttachClick"
                IsEnabled="{x:Bind ViewModel.CanAttach, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind l10n:S.ComposerAttachImage}"
                Visibility="{x:Bind ViewModel.ShowAttach, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE723;" />
                    <TextBlock Text="{x:Bind l10n:S.ComposerAttach}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                AutomationProperties.HelpText="{x:Bind ViewModel.DraftReplyNote, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.DraftReplyLabel, Mode=OneWay}"
                Command="{x:Bind ViewModel.DraftReplyCommand}"
                Content="{x:Bind ViewModel.DraftReplyLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.DraftReplyNote, Mode=OneWay}" />
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    AutomationProperties.AccessibilityView="Raw"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Busy, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="{x:Bind l10n:S.CommonSend}"
                Command="{x:Bind ViewModel.SendCommand}"
                Content="{x:Bind l10n:S.CommonSend}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="{x:Bind l10n:S.ComposerSendTooltip}" />
        </Grid>

        <!-- The AI button's note: what it does, and that each press is billed. -->
        <TextBlock
            Style="{StaticResource QuietTextStyle}"
            Text="{x:Bind ViewModel.DraftReplyNote, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
