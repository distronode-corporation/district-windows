<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DistrictAI.Views.ReportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel MinWidth="360" Spacing="12">
        <!-- Why the report cannot be sent now; the note is kept for next time. -->
        <InfoBar
            x:Name="Refusal"
            AutomationProperties.Name="{x:Bind l10n:S.ReportNotSent}"
            IsClosable="False"
            Severity="Warning" />
        <!-- The words and the note's limit are the core's (DistrictFfi.ReportDialog), set in the constructor. -->
        <TextBlock x:Name="Intro" TextWrapping="Wrap" />
        <TextBox
            x:Name="Note"
            MinHeight="96"
            AcceptsReturn="True"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
