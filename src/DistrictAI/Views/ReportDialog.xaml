<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DistrictAI.Views.ReportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:DistrictAI.L10n"
    Title="{x:Bind l10n:S.ReportTitle}"
    CloseButtonText="{x:Bind l10n:S.CommonCancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind l10n:S.CommonSend}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel MinWidth="360" Spacing="12">
        <!-- Why the report cannot be sent now; the note is kept for next time. -->
        <InfoBar
            x:Name="Refusal"
            AutomationProperties.Name="{x:Bind l10n:S.ReportNotSent}"
            IsClosable="False"
            Severity="Warning" />
        <TextBlock Text="{x:Bind l10n:S.ReportBody}" TextWrapping="Wrap" />
        <TextBox
            x:Name="Note"
            MinHeight="96"
            AcceptsReturn="True"
            AutomationProperties.Name="{x:Bind l10n:S.ReportWhatIsWrong}"
            Header="{x:Bind l10n:S.ReportWhatIsWrong}"
            MaxLength="2000"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
