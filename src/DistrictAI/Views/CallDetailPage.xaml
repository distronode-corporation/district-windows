<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.CallDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource ReadingWidth}"
                Padding="{StaticResource PagePadding}"
                Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource QuietTextStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay}" />
                <!-- A call back, in a build that can carry calls. -->
                <Button
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Call"
                    Command="{x:Bind ViewModel.CallCommand}"
                    Visibility="{x:Bind ViewModel.CanCall, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Phone" />
                        <TextBlock Text="Call" />
                    </StackPanel>
                </Button>
                <views:RefreshStrip x:Name="Refresh" />

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Details" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Facts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FactItem">
                                <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.SummaryLabel, Mode=OneWay}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasAnalysis, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Analysis" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Analysis}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactItem">
                                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasFollowUp, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Follow-up sent" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FollowUp}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactItem">
                                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        Click="OnReportClick"
                        Content="{x:Bind ViewModel.ReportLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.ReportEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ReportVisible, Mode=OneWay}" />

                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Transcript" />
                    <ProgressRing
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Loading the transcript"
                        IsActive="{x:Bind ViewModel.TranscriptLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.TranscriptLoading, Mode=OneWay}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.TranscriptText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasTranscriptText, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.TranscriptMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasTranscriptMessage, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Try loading the transcript again"
                        Command="{x:Bind ViewModel.RetryTranscriptCommand}"
                        Content="Try again"
                        Visibility="{x:Bind ViewModel.CanRetryTranscript, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <views:StatusPanel x:Name="Status" />
    </Grid>
</UserControl>
