<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DistrictAI.Views.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DistrictAI.Views"
    xmlns:vm="using:DistrictAI.ViewModels">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Calls" />
            <!-- The dialler, in a build that can carry calls. -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Place a call"
                Command="{x:Bind ViewModel.PlaceCallCommand}"
                Visibility="{x:Bind ViewModel.CanPlaceCall, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE75F;" />
                    <TextBlock Text="Place a call" />
                </StackPanel>
            </Button>
        </Grid>
        <views:RefreshStrip x:Name="Refresh" Grid.Row="1" />
        <ListView
            Grid.Row="2"
            AutomationProperties.Name="Calls"
            IsItemClickEnabled="True"
            ItemClick="OnCallClick"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.Load.Ready, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CallRowItem">
                    <Grid
                        Padding="0,8"
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource QuietTextStyle}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                MaxLines="2"
                                Text="{x:Bind Summary}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind HasSummary}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource QuietTextStyle}"
                            Text="{x:Bind When}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Load more calls"
                        Command="{x:Bind ViewModel.Paging.LoadMoreCommand}"
                        Content="Load more"
                        IsEnabled="{x:Bind ViewModel.Paging.LoadMoreEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.CanLoadMore, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="Loading more calls"
                        IsActive="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Paging.LoadingMore, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource QuietTextStyle}"
                        Text="{x:Bind ViewModel.Paging.MoreFailureMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        Visibility="{x:Bind ViewModel.Paging.HasMoreFailure, Mode=OneWay}" />
                </StackPanel>
            </ListView.Footer>
        </ListView>
        <views:StatusPanel x:Name="Status" Grid.Row="2" />
    </Grid>
</UserControl>
