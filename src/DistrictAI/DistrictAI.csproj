<Project Sdk="Microsoft.NET.Sdk">
  <!--
    District AI for Windows: a WinUI 3 app, packaged as a single-project MSIX.
    Builds on Windows only (the XAML compiler runs only there); CI builds it on
    windows-2025. It needs district_ffi.dll, a release build of
    crates/district-ffi made first, which it finds through DistrictFfiDir
    (Directory.Build.props) with the property DistrictFfiProfile set to release.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DistrictAI</RootNamespace>
    <AssemblyName>DistrictAI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 only for 1.0: Windows 11 on ARM runs it emulated. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- Program.cs is Main: it redirects a second instance before any XAML loads. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- CsWin32's generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      ReadyToRun, not Native AOT, until the AOT spike proves the generated
      bindings under AOT.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Lets `dotnet restore` (and the lock file) run on Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The package is signed by the Store, or in CI by a throwaway test certificate passed on the command line. -->
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The flavour: Store (Package.appxmanifest) or GitHub
    (Package.GitHub.appxmanifest), the same app under two package identities.
    Pass -p:DistrictFlavour=GitHub for the second.
  -->
  <PropertyGroup>
    <DistrictFlavour Condition="'$(DistrictFlavour)' == ''">Store</DistrictFlavour>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" Condition="'$(DistrictFlavour)' == 'Store'" />
    <AppxManifest Include="Package.GitHub.appxmanifest" Condition="'$(DistrictFlavour)' == 'GitHub'" />
    <None Remove="Package.GitHub.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DistrictAI.Core/DistrictAI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logos at every scale and target size, and the tray icon. -->
    <Content Include="Assets\*.png;Assets\*.ico" />
    <!-- Written by scripts/make-ringtone.py; played from ms-appx:///Assets/Sounds/ringtone.wav. -->
    <Content Include="Assets\Sounds\ringtone.wav" />
    <Manifest Include="$(ApplicationManifest)" />
    <!-- The Rust core, inside the package next to DistrictAI.exe. -->
    <Content Include="$(DistrictFfiDir)district_ffi.dll" Link="district_ffi.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(DistrictFfiDir)district_ffi.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!--
      libwebrtc, which district_ffi.dll links, ships with its licence texts:
      the LICENSE.md of the archive scripts/fetch-libwebrtc.ps1 unpacks into
      LK_CUSTOM_WEBRTC (NOTICE says why).
    -->
    <Content Include="$(LK_CUSTOM_WEBRTC)\LICENSE.md" Link="ThirdPartyNotices\libwebrtc-LICENSE.md" CopyToOutputDirectory="PreserveNewest" Condition="'$(LK_CUSTOM_WEBRTC)' != '' and Exists('$(LK_CUSTOM_WEBRTC)\LICENSE.md')" />
  </ItemGroup>

  <Target Name="RequireLibwebrtcLicence" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT' and ('$(Configuration)' == 'Release' or '$(GenerateAppxPackageOnBuild)' == 'true')">
    <Error Condition="'$(LK_CUSTOM_WEBRTC)' == '' or !Exists('$(LK_CUSTOM_WEBRTC)\LICENSE.md')" Text="libwebrtc's LICENSE.md is not in LK_CUSTOM_WEBRTC ('$(LK_CUSTOM_WEBRTC)'), and a release or a package must ship it. Run scripts/fetch-libwebrtc.ps1 and set LK_CUSTOM_WEBRTC to the directory it prints." />
  </Target>

  <Target Name="RequireOneManifest" BeforeTargets="Build">
    <Error Condition="'@(AppxManifest->Count())' != '1'" Text="Expected one AppxManifest for the $(DistrictFlavour) flavour, found: @(AppxManifest)" />
  </Target>

  <Target Name="RequireDistrictFfi" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(DistrictFfiDir)district_ffi.dll')" Text="district_ffi.dll is not in $(DistrictFfiDir). Run `cargo build -p district-ffi --release` and build with -p:DistrictFfiProfile=release." />
  </Target>
</Project>
